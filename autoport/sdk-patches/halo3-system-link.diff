+// XNetQosListen(const XNKID* pxnkid, const BYTE* pb, UINT cb, DWORD dwBitsPerSec,
+//               DWORD dwFlags)
+u32 NetDll_XNetQosListen_entry(u32 caller, mapped_void id, mapped_void data, u32 data_size, u32 r7,
+                               u32 flags) {
