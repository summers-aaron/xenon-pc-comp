+std::mutex secure_mutex;
+std::unordered_map<uint32_t, uint32_t> secure_to_ip;
+std::unordered_map<uint32_t, uint32_t> ip_to_secure;
+uint32_t next_secure = 1;
+std::unordered_set<uint32_t> title_server_secure;
