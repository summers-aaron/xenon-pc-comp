+// This instance's XNADDR (same shape XNetGetTitleXnAddr returns).
+void WriteOwnXnAddr(uint8_t* xna) {
+  std::memset(xna, 0, 0x24);
+  const uint32_t ip = xnet::LocalAddress();
+  store_and_swap<uint32_t>(xna + 0, ip);  // ina (network order)
+  const uint8_t enet[6] = {0x00, 0x1D, 0xD8, uint8_t(ip >> 16), uint8_t(ip >> 8), uint8_t(ip)};
+  std::memcpy(xna + 10, enet, 6);
+}
