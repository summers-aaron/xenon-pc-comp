+// Guest (Windows) SOL_SOCKET option names -> host.
+bool TranslateSocketOption(uint32_t level, uint32_t optname, int* host_level, int* host_name) {
+  if (level == 0xFFFF) {
+    *host_level = SOL_SOCKET;
+    switch (optname) {
+      case 0x0004: *host_name = SO_REUSEADDR; return true;
+      case 0x0008: *host_name = SO_KEEPALIVE; return true;
+      case 0x0020: *host_name = SO_BROADCAST; return true;
+      case 0x0080: *host_name = SO_LINGER; return true;
+      case 0x1001: *host_name = SO_SNDBUF; return true;
+      case 0x1002: *host_name = SO_RCVBUF; return true;
+      case 0x1005: *host_name = SO_SNDTIMEO; return true;
+      case 0x1006: *host_name = SO_RCVTIMEO; return true;
+      case 0x1007: *host_name = SO_ERROR; return true;
+      case 0x1008: *host_name = SO_TYPE; return true;
+      default: return false;
+    }
+  }
+  if (level == 6 && optname == 1) {  // IPPROTO_TCP, TCP_NODELAY
+    *host_level = IPPROTO_TCP;
+    *host_name = 1;
+    return true;
+  }
+  return false;
+}
