+/**
+ * @file        xlive.cpp
+ * @brief       Client for an Xbox Live stand-in server; see xlive.h.
+ */
+
+#include <rex/system/xlive.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <fstream>
+#include <mutex>
+#include <thread>
