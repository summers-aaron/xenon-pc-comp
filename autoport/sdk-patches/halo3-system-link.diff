+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_STRING(live_server, "", "Network",
+                      "Xbox Live stand-in server (halo3-live-phoenix), e.g. "
+                      "http://127.0.0.1:36080. Empty: offline.");
+
+namespace rex::system::xlive {
+
+namespace {
+
+struct ServerUrl {
+  std::string host;
+  uint16_t port = 80;
+  std::string base_path;  // without trailing '/'
+};
+
+std::optional<ServerUrl> ParseServer() {
+  std::string url = REXCVAR_GET(live_server);
+  if (url.empty()) {
+    return std::nullopt;
+  }
+  constexpr std::string_view kScheme = "http://";
+  if (url.rfind(kScheme, 0) == 0) {
+    url = url.substr(kScheme.size());
+  }
+  ServerUrl out;
+  const size_t slash = url.find('/');
+  std::string authority = url.substr(0, slash);
+  if (slash != std::string::npos) {
+    out.base_path = url.substr(slash);
+    while (!out.base_path.empty() && out.base_path.back() == '/') {
+      out.base_path.pop_back();
+    }
+  }
+  const size_t colon = authority.rfind(':');
+  if (colon != std::string::npos) {
+    out.port = uint16_t(std::stoi(authority.substr(colon + 1)));
+    authority = authority.substr(0, colon);
+  }
+  out.host = authority;
+  return out;
+}
+
+std::mutex token_mutex;
+std::string auth_token;  // the signed-in account's token, sent on every request
+
+std::string Token() {
+  std::lock_guard<std::mutex> lock(token_mutex);
+  return auth_token;
+}
+
+const std::optional<ServerUrl>& Server() {
+  static const std::optional<ServerUrl> server = ParseServer();
+  return server;
+}
+
+#if !REX_PLATFORM_WIN32
+// Reads until the peer closes (the request asks for Connection: close).
+bool ReadAll(int fd, std::string* out, int timeout_ms) {
+  char buf[16384];
+  for (;;) {
+    pollfd p{fd, POLLIN, 0};
+    const int r = poll(&p, 1, timeout_ms);
+    if (r <= 0) {
+      return false;
+    }
+    const ssize_t n = recv(fd, buf, sizeof(buf), 0);
+    if (n < 0) {
+      return false;
+    }
+    if (n == 0) {
+      return true;
+    }
+    out->append(buf, size_t(n));
+  }
+}
+#endif
+
+}  // namespace
+
+bool Enabled() {
+  return Server().has_value();
+}
+
+uint32_t ServerAddress() {
+  static const uint32_t address = [] {
+    if (!Server()) {
+      return 0u;
+    }
+    addrinfo hints{};
+    hints.ai_family = AF_INET;
+    addrinfo* res = nullptr;
+    uint32_t ip = 0;
+    if (getaddrinfo(Server()->host.c_str(), nullptr, &hints, &res) == 0 && res) {
+      ip = ntohl(reinterpret_cast<sockaddr_in*>(res->ai_addr)->sin_addr.s_addr);
+      freeaddrinfo(res);
+    }
+    return ip;
+  }();
+  return address;
+}
+
+uint16_t ServerPort() {
+  return Server() ? Server()->port : 0;
+}
+
+HttpResponse Request(const std::string& method, const std::string& path, const std::string& body,
+                     const std::string& content_type) {
+  HttpResponse response;
+#if REX_PLATFORM_WIN32
+  (void)method, (void)path, (void)body, (void)content_type;
+  REXSYS_WARN("xlive: HTTP client not implemented on Windows");
+  return response;
+#else
+  const auto& server = Server();
+  if (!server || !ServerAddress()) {
+    return response;
+  }
+  const int fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0) {
+    return response;
+  }
+  timeval tv{5, 0};
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(server->port);
+  addr.sin_addr.s_addr = htonl(ServerAddress());
+  if (connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
+    REXSYS_WARN("xlive: cannot reach {}:{}: {}", server->host, server->port, strerror(errno));
+    close(fd);
+    return response;
+  }
+  std::string request = fmt::format(
+      "{} {}{} HTTP/1.1\r\nHost: {}:{}\r\nConnection: close\r\nAccept: */*\r\n", method,
+      server->base_path, path, server->host, server->port);
+  if (const std::string token = Token(); !token.empty()) {
+    request += fmt::format("Authorization: Bearer {}\r\n", token);
+  }
+  if (!body.empty() || method == "POST" || method == "PUT") {
+    request += fmt::format("Content-Type: {}\r\nContent-Length: {}\r\n", content_type, body.size());
+  }
+  request += "\r\n";
+  request += body;
+  size_t sent = 0;
+  while (sent < request.size()) {
+    const ssize_t n = send(fd, request.data() + sent, request.size() - sent, MSG_NOSIGNAL);
+    if (n <= 0) {
+      close(fd);
+      return response;
+    }
+    sent += size_t(n);
+  }
+  std::string raw;
+  const bool complete = ReadAll(fd, &raw, 5000);
+  close(fd);
+  const size_t header_end = raw.find("\r\n\r\n");
+  if (!complete || header_end == std::string::npos || raw.compare(0, 5, "HTTP/") != 0) {
+    REXSYS_WARN("xlive: bad response for {} {}", method, path);
+    return response;
+  }
+  response.status = std::atoi(raw.c_str() + raw.find(' ') + 1);
+  std::string headers = raw.substr(0, header_end);
+  response.body = raw.substr(header_end + 4);
+  // Phoenix answers with Content-Length; decode chunked bodies just in case.
+  std::string lower = headers;
+  for (auto& c : lower) c = char(std::tolower(uint8_t(c)));
+  if (lower.find("transfer-encoding: chunked") != std::string::npos) {
+    std::string decoded;
+    size_t pos = 0;
+    while (pos < response.body.size()) {
+      const size_t eol = response.body.find("\r\n", pos);
+      if (eol == std::string::npos) break;
+      const size_t size = std::stoul(response.body.substr(pos, eol - pos), nullptr, 16);
+      if (!size) break;
+      decoded.append(response.body, eol + 2, size);
+      pos = eol + 2 + size + 2;
+    }
+    response.body = std::move(decoded);
+  }
+  return response;
+#endif
+}
+
+std::string Hex64(uint64_t v) {
+  return fmt::format("{:016X}", v);
+}
+
+std::string Hex32(uint32_t v) {
+  return fmt::format("{:08X}", v);
+}
+
+std::optional<uint64_t> ParseHex64(const std::string& s) {
+  if (s.empty() || s.size() > 16) {
+    return std::nullopt;
+  }
+  uint64_t v = 0;
+  for (char c : s) {
+    v <<= 4;
+    if (c >= '0' && c <= '9') v |= uint64_t(c - '0');
+    else if (c >= 'a' && c <= 'f') v |= uint64_t(c - 'a' + 10);
+    else if (c >= 'A' && c <= 'F') v |= uint64_t(c - 'A' + 10);
+    else return std::nullopt;
+  }
+  return v;
+}
+
+uint64_t MachineId() {
+  // Same derivation as XNetXnAddrToMachineId: 0xFA + the 6-byte MAC.
+  const uint32_t ip = xnet::LocalAddress();
+  return 0xFA00000000000000ull | 0x001DD8000000ull | ((ip & 0xFFFFFF));
+}
+
+std::string MacAddressHex() {
+  const uint32_t ip = xnet::LocalAddress();
+  return fmt::format("001DD8{:02X}{:02X}{:02X}", (ip >> 16) & 0xFF, (ip >> 8) & 0xFF, ip & 0xFF);
+}
+
+std::string Base64Encode(const uint8_t* data, size_t size) {
+  static const char* kChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  std::string out;
+  out.reserve((size + 2) / 3 * 4);
+  for (size_t i = 0; i < size; i += 3) {
+    uint32_t v = uint32_t(data[i]) << 16;
+    if (i + 1 < size) v |= uint32_t(data[i + 1]) << 8;
+    if (i + 2 < size) v |= data[i + 2];
+    out += kChars[(v >> 18) & 63];
+    out += kChars[(v >> 12) & 63];
+    out += i + 1 < size ? kChars[(v >> 6) & 63] : '=';
+    out += i + 2 < size ? kChars[v & 63] : '=';
+  }
+  return out;
+}
+
+std::vector<uint8_t> Base64Decode(const std::string& text) {
+  auto value = [](char c) -> int {
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+' || c == '-') return 62;
+    if (c == '/' || c == '_') return 63;
+    return -1;
+  };
+  std::vector<uint8_t> out;
+  uint32_t acc = 0;
+  int bits = 0;
+  for (char c : text) {
+    const int v = value(c);
+    if (v < 0) continue;
+    acc = (acc << 6) | uint32_t(v);
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out.push_back(uint8_t(acc >> bits));
+    }
+  }
+  return out;
+}
+
+std::optional<Account> SignIn(const std::string& gamertag,
+                              const std::filesystem::path& account_file) {
+  if (!Enabled()) {
+    return std::nullopt;
+  }
+  std::optional<Account> saved;
+  {
+    std::ifstream in(account_file);
+    nlohmann::json j = nlohmann::json::parse(in, nullptr, false);
+    if (!j.is_discarded() && j.is_object()) {
+      const auto xuid = ParseHex64(j.value("xuid", ""));
+      if (xuid && !j.value("token", "").empty()) {
+        saved = Account{*xuid, j.value("gamertag", ""), j.value("token", "")};
+      }
+    }
+  }
+  if (saved) {
+    std::lock_guard<std::mutex> lock(token_mutex);
+    auth_token = saved->token;
+  }
+  const auto r = Request("POST", "/xlive/v1/accounts", nlohmann::json{{"gamertag", gamertag}}.dump());
+  nlohmann::json body = nlohmann::json::parse(r.body, nullptr, false);
+  if (!r.ok() || body.is_discarded() || !ParseHex64(body.value("xuid", ""))) {
+    if (saved) {
+      REXSYS_WARN("xlive: account check failed (HTTP {}); using saved account {} ({})", r.status,
+                  saved->gamertag, Hex64(saved->xuid));
+    } else {
+      REXSYS_WARN("xlive: cannot create an account (HTTP {}): {}", r.status, r.body);
+    }
+    return saved;
+  }
+  Account account{*ParseHex64(body.value("xuid", "")), body.value("gamertag", gamertag),
+                  body.value("token", saved ? saved->token : std::string())};
+  {
+    std::lock_guard<std::mutex> lock(token_mutex);
+    auth_token = account.token;
+  }
+  if (!saved || saved->xuid != account.xuid || saved->gamertag != account.gamertag ||
+      saved->token != account.token) {
+    std::error_code ec;
+    std::filesystem::create_directories(account_file.parent_path(), ec);
+    std::ofstream out(account_file, std::ios::trunc);
+    out << nlohmann::json{{"xuid", Hex64(account.xuid)},
+                          {"gamertag", account.gamertag},
+                          {"token", account.token}}
+               .dump(2)
+        << "\n";
+    if (!out) {
+      REXSYS_WARN("xlive: cannot save the account to {}", account_file.string());
+    }
+  }
+  REXSYS_INFO("xlive: account {} ({}){}", account.gamertag, Hex64(account.xuid),
+              saved ? "" : ", new");
+  return account;
+}
+
+void StartPresence(uint64_t xuid, const std::string& gamertag) {
+  static std::once_flag once;
+  if (!Enabled()) {
+    return;
+  }
+  std::call_once(once, [xuid, gamertag] {
+    std::thread([xuid, gamertag] {
+      bool reported = false;
+      // The first registration of this process lets the server drop sessions
+      // this player hosted from an earlier (crashed / restarted) process.
+      bool new_instance = true;
+      for (;;) {
+        nlohmann::json player = {
+            {"xuid", Hex64(xuid)},
+            {"gamertag", gamertag},
+            {"machineId", Hex64(MachineId())},
+            {"macAddress", MacAddressHex()},
+            {"hostAddress", fmt::format("{}.{}.{}.{}", xnet::LocalAddress() >> 24,
+                                        (xnet::LocalAddress() >> 16) & 0xFF,
+                                        (xnet::LocalAddress() >> 8) & 0xFF,
+                                        xnet::LocalAddress() & 0xFF)},
+            {"port", xnet::ToHostPort(1000)},
+            {"newInstance", new_instance},
+        };
