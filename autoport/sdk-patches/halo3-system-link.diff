+      {"macAddress", xlive::MacAddressHex()},
+      {"port", xnet::ToHostPort(1000)},
+      {"xnaddr", xlive::Base64Encode(s.info + 8, 0x24)},
+      {"xnkey", xlive::Base64Encode(s.info + 0x2C, 0x10)},
+  };
+}
+
+void PushUserData(system::KernelState* ks, uint32_t user_index) {
+  // A host's contexts/properties are its session's attributes on Live.
+  std::vector<uint64_t> ids;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    for (const auto& [obj, s] : sessions) {
+      if (s.host && s.user_index == user_index) ids.push_back(s.id);
+    }
+  }
+  if (ids.empty() || user_index >= 4) return;
+  json body;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    body = {{"properties", PropertiesJson(users[user_index].properties)},
+            {"contexts", ContextsJson(users[user_index].contexts)}};
+  }
+  for (uint64_t id : ids) {
+    Call("POST", SessionPath(ks, id) + "/properties", body);
+  }
+}
+
+// ---- guest result writers -------------------------------------------------
+
+// Fills XSESSION_SEARCHRESULT_HEADER + results (+ their properties/contexts)
+// into the title's buffer; results that do not fit are dropped.
+void WriteSearchResults(system::KernelState* ks, const json& list, uint32_t results_ptr,
+                        uint32_t buffer_size) {
+  auto* mem = ks->memory();
+  uint8_t* base = mem->TranslateVirtual<uint8_t*>(results_ptr);
+  if (!base || buffer_size < 8) return;
+  std::memset(base, 0, buffer_size);
+
+  struct Parsed {
+    const json* session;
+    std::vector<Property> properties;
+    std::vector<std::pair<uint32_t, uint32_t>> contexts;
+    size_t tail = 0;
+  };
+  std::vector<Parsed> parsed;
+  for (const auto& s : list) {
+    Parsed p{&s, {}, {}, 0};
+    for (const auto& c : s.value("contexts", json::array())) {
+      p.contexts.emplace_back(uint32_t(xlive::ParseHex64(c.value("id", "0")).value_or(0)),
+                              c.value("value", 0u));
+    }
+    for (const auto& j : s.value("properties", json::array())) {
+      p.properties.push_back(PropertyFromJson(j));
+    }
+    p.tail = p.contexts.size() * kContextSize + p.properties.size() * kPropertySize;
+    for (const auto& prop : p.properties) p.tail += PropertyExtra(prop);
+    parsed.push_back(std::move(p));
+  }
+  // Keep as many results as fit.
+  size_t count = parsed.size();
+  for (;; --count) {
+    size_t need = 8 + count * kSearchResultSize;
+    for (size_t i = 0; i < count; ++i) need += parsed[i].tail;
+    if (need <= buffer_size || count == 0) break;
+  }
+
+  uint32_t tail_guest = results_ptr + 8 + uint32_t(count * kSearchResultSize);
+  for (size_t i = 0; i < count; ++i) {
+    const json& s = *parsed[i].session;
+    uint8_t* r = base + 8 + i * kSearchResultSize;
+    store_and_swap<uint64_t>(r + 0, xlive::ParseHex64(s.value("sessionId", "0")).value_or(0));
+    const auto xnaddr = xlive::Base64Decode(s.value("xnaddr", ""));
+    std::memcpy(r + 8, xnaddr.data(), std::min<size_t>(xnaddr.size(), 0x24));
+    const auto xnkey = xlive::Base64Decode(s.value("xnkey", ""));
+    std::memcpy(r + 0x2C, xnkey.data(), std::min<size_t>(xnkey.size(), 0x10));
+    store_and_swap<uint32_t>(r + 60, s.value("openPublicSlots", 0u));
+    store_and_swap<uint32_t>(r + 64, s.value("openPrivateSlots", 0u));
+    store_and_swap<uint32_t>(r + 68, s.value("filledPublicSlots", 0u));
+    store_and_swap<uint32_t>(r + 72, s.value("filledPrivateSlots", 0u));
+    store_and_swap<uint32_t>(r + 76, uint32_t(parsed[i].properties.size()));
+    store_and_swap<uint32_t>(r + 80, uint32_t(parsed[i].contexts.size()));
+    // Contexts, then properties, then property payloads.
+    const uint32_t ctx_guest = tail_guest;
+    uint8_t* ctx = mem->TranslateVirtual<uint8_t*>(ctx_guest);
+    for (size_t c = 0; c < parsed[i].contexts.size(); ++c) {
+      store_and_swap<uint32_t>(ctx + c * 8 + 0, parsed[i].contexts[c].first);
+      store_and_swap<uint32_t>(ctx + c * 8 + 4, parsed[i].contexts[c].second);
+    }
+    const uint32_t props_guest = ctx_guest + uint32_t(parsed[i].contexts.size() * kContextSize);
+    uint32_t extra_guest = props_guest + uint32_t(parsed[i].properties.size() * kPropertySize);
+    for (size_t k = 0; k < parsed[i].properties.size(); ++k) {
+      const Property& prop = parsed[i].properties[k];
+      WriteGuestProperty(mem->TranslateVirtual<uint8_t*>(props_guest + uint32_t(k * kPropertySize)),
+                         prop, mem->TranslateVirtual<uint8_t*>(extra_guest), extra_guest);
+      extra_guest += uint32_t(PropertyExtra(prop));
+    }
+    store_and_swap<uint32_t>(r + 84, parsed[i].properties.empty() ? 0 : props_guest);
+    store_and_swap<uint32_t>(r + 88, parsed[i].contexts.empty() ? 0 : ctx_guest);
+    tail_guest += uint32_t(parsed[i].tail);
+  }
+  store_and_swap<uint32_t>(base + 0, uint32_t(count));
+  store_and_swap<uint32_t>(base + 4, count ? results_ptr + 8 : 0);
+}
+
+json SearchBody(system::KernelState* ks, uint32_t proc_index, uint32_t num_results,
+                uint32_t num_users, uint32_t num_props, uint32_t props_ptr, uint32_t num_ctx,
+                uint32_t ctx_ptr) {
+  auto* mem = ks->memory();
+  json properties = json::array(), contexts = json::array();
+  for (uint32_t i = 0; props_ptr && i < num_props; ++i) {
+    properties.push_back(PropertyJson(
+        ReadGuestProperty(ks, mem->TranslateVirtual<uint8_t*>(props_ptr + i * kPropertySize))));
+  }
+  for (uint32_t i = 0; ctx_ptr && i < num_ctx; ++i) {
+    const uint8_t* c = mem->TranslateVirtual<uint8_t*>(ctx_ptr + i * kContextSize);
+    contexts.push_back({{"id", xlive::Hex32(load_and_swap<uint32_t>(c))},
+                        {"value", load_and_swap<uint32_t>(c + 4)}});
+  }
+  return {{"procedureIndex", proc_index}, {"maxResults", num_results},
+          {"numUsers", std::max<uint32_t>(num_users, 1)}, {"properties", properties},
+          {"contexts", contexts}, {"excludeXuid", xlive::Hex64(OurXuid(ks))}};
+}
+
+X_HRESULT Search(system::KernelState* ks, const json& body, uint32_t results_ptr,
+                 uint32_t buffer_size) {
+  auto r = Call("POST", TitlePath(ks) + "/sessions/search", body);
+  const json list = r ? r->value("sessions", json::array()) : json::array();
+  WriteSearchResults(ks, list, results_ptr, buffer_size);
+  if (REXCVAR_GET(net_log)) {
+    REXKRNL_INFO("xlive: XSessionSearch proc {} -> {} sessions", body.value("procedureIndex", 0u),
+                 list.size());
+  }
+  return X_E_SUCCESS;
+}
+
+Session* Find(uint32_t obj) {
+  auto it = sessions.find(obj);
+  return it == sessions.end() ? nullptr : &it->second;
+}
+
+std::vector<json> Members(system::KernelState* ks, uint32_t count, uint32_t xuids_ptr,
+                          uint32_t indices_ptr, uint32_t private_ptr) {
+  auto* mem = ks->memory();
+  std::vector<json> out;
+  for (uint32_t i = 0; i < count && i < 16; ++i) {
+    uint64_t xuid = 0;
+    if (xuids_ptr) {
+      xuid = load_and_swap<uint64_t>(mem->TranslateVirtual<uint8_t*>(xuids_ptr + i * 8));
+    } else if (indices_ptr) {
+      const uint32_t index = load_and_swap<uint32_t>(mem->TranslateVirtual<uint8_t*>(indices_ptr + i * 4));
+      if (index != 0) continue;  // one local profile
+      xuid = OurXuid(ks);
+    }
+    const bool is_private =
+        private_ptr && load_and_swap<uint32_t>(mem->TranslateVirtual<uint8_t*>(private_ptr + i * 4));
+    if (xuid) {
+      out.push_back({{"xuid", xlive::Hex64(xuid)}, {"private", is_private}});
+    }
+  }
+  return out;
+}
