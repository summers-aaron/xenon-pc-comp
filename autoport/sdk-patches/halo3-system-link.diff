diff --git a/src/kernel/xam/xam_task.cpp b/src/kernel/xam/xam_task.cpp
index e0e7dab..492d8d3 100644
--- a/src/kernel/xam/xam_task.cpp
+++ b/src/kernel/xam/xam_task.cpp
@@ -27,6 +27,11 @@
 
 #include <fmt/format.h>
 
+#include <chrono>
+#include <mutex>
+#include <utility>
+#include <vector>
+
 namespace rex {
 namespace kernel {
 namespace xam {
@@ -44,8 +49,50 @@ struct XTASK_MESSAGE {
 };
 static_assert_size(XTASK_MESSAGE, 0x1C);
 
+bool XamFreeIfAllocated(uint32_t ptr);  // xam_info.cpp
+
+namespace {
+// autoport: a scheduled task owns its message block (the title only frees it
+// when scheduling fails), and XAM releases it once the task is done. Without
+// that, titles that schedule tasks continuously (Halo: Reach, ~17/s) exhaust
+// the guest heap within minutes. Finished tasks are reaped on the next
+// schedule call.
+std::mutex task_mutex;
+struct RunningTask {
+  object_ref<XThread> thread;
+  uint32_t message;
+  std::chrono::steady_clock::time_point finished{};  // set when first seen done
+};
+std::vector<RunningTask> running_tasks;
+
+void ReapFinishedTasks() {
+  // The title can still look at the block through its overlapped structure
+  // right after the task ends, so keep it for a grace period.
+  constexpr auto kGrace = std::chrono::seconds(2);
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(task_mutex);
+  for (auto it = running_tasks.begin(); it != running_tasks.end();) {
+    if (it->thread->is_running()) {
+      ++it;
+      continue;
+    }
+    if (it->finished == std::chrono::steady_clock::time_point{}) {
+      it->finished = now;
+    }
+    if (now - it->finished >= kGrace) {
+      XamFreeIfAllocated(it->message);
+      it = running_tasks.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+}  // namespace
+
 u32 XamTaskSchedule_entry(mapped_void callback, ppc_ptr_t<XTASK_MESSAGE> message,
                           mapped_u32 unknown, mapped_u32 handle_ptr) {
+  ReapFinishedTasks();
+
   // TODO(gibbed): figure out what this is for
   *handle_ptr = 12345;
 
@@ -67,6 +114,10 @@ u32 XamTaskSchedule_entry(mapped_void callback, ppc_ptr_t<XTASK_MESSAGE> message
   }
 
   REXKRNL_DEBUG("XAM task ({:08X}) scheduled asynchronously", callback.guest_address());
+  {
+    std::lock_guard<std::mutex> lock(task_mutex);
+    running_tasks.push_back({thread, message.guest_address()});
+  }
 
   return X_STATUS_SUCCESS;
 }
