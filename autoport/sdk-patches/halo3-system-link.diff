index 0000000..794c8aa
--- /dev/null
+++ b/src/kernel/xam/apps/xgi_live.cpp
@@ -0,0 +1,967 @@
+/**
+ * @file        xgi_live.cpp
+ * @brief       XGI sessions backed by the Xbox Live stand-in server.
+ *
+ * Guest layouts (big-endian), as the XDK defines them:
+ *   XSESSION_INFO (0x3C): XNKID sessionID; XNADDR hostAddress (0x24);
+ *                         XNKEY keyExchangeKey (0x10)
+ *   XSESSION_SEARCHRESULT (0x5C): info; open/filled public/private slots;
+ *                         cProperties; cContexts; pProperties; pContexts
+ *   XUSER_CONTEXT (8), XUSER_PROPERTY (0x18: id, pad, X_USER_DATA)
+ *   XSESSION_LOCAL_DETAILS (0x80), XSESSION_MEMBER (0x10)
+ *   XSESSION_REGISTRATION_RESULTS (8), XSESSION_REGISTRANT (0x18)
+ * Server contract: halo3-live-phoenix docs/design.md.
+ */
+
+#include "xgi_live.h"
+
+#include <atomic>
+#include <bit>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <random>
+#include <string>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+#include <rex/system/xam/user_profile.h>
+#include <rex/system/xlive.h>
+#include <rex/system/xsocket.h>
+
+#include <fmt/format.h>
+#include <inja/third_party/include/nlohmann/json.hpp>
+
+REXCVAR_DECLARE(bool, net_log);
+
+namespace rex::kernel::xam::xgi_live {
+
+using json = nlohmann::json;
+using rex::memory::load_and_swap;
+using rex::memory::store_and_swap;
+namespace xlive = rex::system::xlive;
+namespace xnet = rex::system::xnet;
+
+namespace {
+
+// XSESSION_CREATE_* flags.
+constexpr uint32_t kFlagHost = 0x1;
+constexpr uint32_t kFlagsLive = 0x2 | 0x4 | 0x8 | 0x10;  // presence, stats, matchmaking, arbitration
+
+constexpr uint32_t kContextGameType = 0x0000800A;
+constexpr uint32_t kContextGameMode = 0x0000800B;
+
+constexpr uint32_t kUserIndexNone = 0xFE;
+
+constexpr size_t kInfoSize = 0x3C;
+constexpr size_t kSearchResultSize = 0x5C;
+constexpr size_t kPropertySize = 0x18;
+constexpr size_t kContextSize = 0x8;
+
+// X_USER_DATA types.
+enum : uint8_t {
+  kTypeContext = 0,
+  kTypeInt32 = 1,
+  kTypeInt64 = 2,
+  kTypeDouble = 3,
+  kTypeWString = 4,
+  kTypeFloat = 5,
+  kTypeBinary = 6,
+  kTypeDateTime = 7,
+  kTypeNull = 0xFF,
+};
+
+struct Property {
+  uint32_t id = 0;
+  uint8_t type = kTypeNull;
+  uint64_t bits = 0;          // numeric value (int/float/double bits, filetime)
+  std::vector<uint8_t> blob;  // wstring (UTF-16BE, no terminator) / binary
+};
+
+struct UserData {
+  std::map<uint32_t, uint32_t> contexts;
+  std::map<uint32_t, Property> properties;
+};
+
+struct Session {
+  uint64_t id = 0;
+  uint32_t flags = 0;
+  uint32_t public_slots = 0;
+  uint32_t private_slots = 0;
+  uint32_t user_index = 0;
