+std::string Utf16BeToUtf8(const std::vector<uint8_t>& blob) {
+  std::string out;
+  for (size_t i = 0; i + 1 < blob.size(); i += 2) {
+    const uint32_t c = uint32_t(blob[i]) << 8 | blob[i + 1];
+    if (!c) break;
+    if (c < 0x80) {
+      out += char(c);
+    } else if (c < 0x800) {
+      out += char(0xC0 | (c >> 6));
+      out += char(0x80 | (c & 0x3F));
+    } else {
+      out += char(0xE0 | (c >> 12));
+      out += char(0x80 | ((c >> 6) & 0x3F));
+      out += char(0x80 | (c & 0x3F));
+    }
+  }
+  return out;
+}
+
+std::vector<uint8_t> Utf8ToUtf16Be(const std::string& s) {
+  std::vector<uint8_t> out;
+  for (size_t i = 0; i < s.size();) {
+    uint32_t c = uint8_t(s[i]);
+    if (c >= 0xE0 && i + 2 < s.size()) {
+      c = (c & 0x0F) << 12 | (uint8_t(s[i + 1]) & 0x3F) << 6 | (uint8_t(s[i + 2]) & 0x3F);
+      i += 3;
+    } else if (c >= 0xC0 && i + 1 < s.size()) {
+      c = (c & 0x1F) << 6 | (uint8_t(s[i + 1]) & 0x3F);
+      i += 2;
+    } else {
+      i += 1;
+    }
+    out.push_back(uint8_t(c >> 8));
+    out.push_back(uint8_t(c));
+  }
+  return out;
+}
+
+const char* TypeName(uint8_t type) {
+  switch (type) {
+    case kTypeInt32: return "int32";
+    case kTypeInt64: return "int64";
+    case kTypeDouble: return "double";
+    case kTypeWString: return "string";
+    case kTypeFloat: return "float";
+    case kTypeBinary: return "binary";
+    case kTypeDateTime: return "datetime";
+    default: return "null";
+  }
+}
+
+uint8_t TypeFromName(const std::string& name) {
+  if (name == "int32") return kTypeInt32;
+  if (name == "int64") return kTypeInt64;
+  if (name == "double") return kTypeDouble;
+  if (name == "string") return kTypeWString;
+  if (name == "float") return kTypeFloat;
+  if (name == "binary") return kTypeBinary;
+  if (name == "datetime") return kTypeDateTime;
+  return kTypeNull;
+}
+
+json PropertyJson(const Property& p) {
+  json j = {{"id", xlive::Hex32(p.id)}, {"type", TypeName(p.type)}};
+  switch (p.type) {
+    case kTypeInt32: j["value"] = int32_t(uint32_t(p.bits)); break;
+    case kTypeInt64: j["value"] = int64_t(p.bits); break;
+    case kTypeDateTime: j["value"] = p.bits; break;
+    case kTypeDouble: j["value"] = std::bit_cast<double>(p.bits); break;
+    case kTypeFloat: j["value"] = double(std::bit_cast<float>(uint32_t(p.bits))); break;
+    case kTypeWString: j["value"] = Utf16BeToUtf8(p.blob); break;
+    case kTypeBinary: j["value"] = xlive::Base64Encode(p.blob.data(), p.blob.size()); break;
+    default: j["value"] = nullptr; break;
+  }
+  return j;
+}
+
+Property PropertyFromJson(const json& j) {
+  Property p;
+  p.id = uint32_t(xlive::ParseHex64(j.value("id", "0")).value_or(0));
+  p.type = TypeFromName(j.value("type", "null"));
+  const json& v = j.contains("value") ? j["value"] : json();
+  switch (p.type) {
+    case kTypeInt32: p.bits = uint32_t(v.is_number() ? v.get<int64_t>() : 0); break;
+    case kTypeInt64:
+    case kTypeDateTime: p.bits = uint64_t(v.is_number() ? v.get<int64_t>() : 0); break;
+    case kTypeDouble: p.bits = std::bit_cast<uint64_t>(v.is_number() ? v.get<double>() : 0.0); break;
+    case kTypeFloat:
+      p.bits = std::bit_cast<uint32_t>(float(v.is_number() ? v.get<double>() : 0.0));
+      break;
+    case kTypeWString: p.blob = Utf8ToUtf16Be(v.is_string() ? v.get<std::string>() : ""); break;
+    case kTypeBinary: p.blob = xlive::Base64Decode(v.is_string() ? v.get<std::string>() : ""); break;
+    default: break;
+  }
+  return p;
+}
+
+// Reads a guest XUSER_PROPERTY.
+Property ReadGuestProperty(system::KernelState* ks, const uint8_t* g) {
+  Property p;
+  p.id = load_and_swap<uint32_t>(g + 0);
+  p.type = g[8];
+  const uint8_t* u = g + 16;
+  switch (p.type) {
+    case kTypeInt32:
+    case kTypeFloat: p.bits = load_and_swap<uint32_t>(u); break;
+    case kTypeInt64:
+    case kTypeDouble:
+    case kTypeDateTime: p.bits = load_and_swap<uint64_t>(u); break;
+    case kTypeWString:
+    case kTypeBinary: {
+      const uint32_t size = load_and_swap<uint32_t>(u + 0);
+      const uint32_t ptr = load_and_swap<uint32_t>(u + 4);
+      if (ptr && size && size < 0x10000) {
+        const uint8_t* data = ks->memory()->TranslateVirtual<uint8_t*>(ptr);
+        p.blob.assign(data, data + size);
+        if (p.type == kTypeWString) {  // drop the terminator
+          while (p.blob.size() >= 2 && !p.blob[p.blob.size() - 1] && !p.blob[p.blob.size() - 2]) {
+            p.blob.resize(p.blob.size() - 2);
+          }
+        }
+      }
+      break;
+    }
+    default: break;
+  }
+  return p;
+}
+
+// XGIUserSetPropertyEx value: raw big-endian bytes of the property's type.
+Property PropertyFromRaw(uint32_t id, const uint8_t* value, uint32_t size) {
+  Property p;
+  p.id = id;
+  p.type = uint8_t((id >> 28) & 0xF);
+  switch (p.type) {
+    case kTypeInt32:
+    case kTypeFloat: p.bits = size >= 4 ? load_and_swap<uint32_t>(value) : 0; break;
+    case kTypeInt64:
+    case kTypeDouble:
+    case kTypeDateTime: p.bits = size >= 8 ? load_and_swap<uint64_t>(value) : 0; break;
+    case kTypeWString:
+    case kTypeBinary:
+      if (value && size < 0x10000) {
+        p.blob.assign(value, value + size);
+      }
+      if (p.type == kTypeWString) {
+        while (p.blob.size() >= 2 && !p.blob[p.blob.size() - 1] && !p.blob[p.blob.size() - 2]) {
+          p.blob.resize(p.blob.size() - 2);
+        }
+      }
+      break;
+    default: break;
+  }
+  return p;
+}
+
+// Bytes a property needs past its XUSER_PROPERTY (string/binary payloads).
+size_t PropertyExtra(const Property& p) {
+  if (p.type == kTypeWString) return (p.blob.size() + 2 + 3) & ~size_t(3);
+  if (p.type == kTypeBinary) return (p.blob.size() + 3) & ~size_t(3);
+  return 0;
+}
+
+// Writes a guest XUSER_PROPERTY; payload goes to *extra (guest address advanced).
+void WriteGuestProperty(uint8_t* g, const Property& p, uint8_t* extra_host, uint32_t extra_guest) {
+  std::memset(g, 0, kPropertySize);
+  store_and_swap<uint32_t>(g + 0, p.id);
+  g[8] = p.type;
+  uint8_t* u = g + 16;
+  switch (p.type) {
+    case kTypeInt32:
+    case kTypeFloat: store_and_swap<uint32_t>(u, uint32_t(p.bits)); break;
+    case kTypeInt64:
+    case kTypeDouble:
+    case kTypeDateTime: store_and_swap<uint64_t>(u, p.bits); break;
+    case kTypeWString:
+      std::memcpy(extra_host, p.blob.data(), p.blob.size());
+      extra_host[p.blob.size()] = 0;
+      extra_host[p.blob.size() + 1] = 0;
+      store_and_swap<uint32_t>(u + 0, uint32_t(p.blob.size() + 2));
+      store_and_swap<uint32_t>(u + 4, extra_guest);
+      break;
+    case kTypeBinary:
+      std::memcpy(extra_host, p.blob.data(), p.blob.size());
+      store_and_swap<uint32_t>(u + 0, uint32_t(p.blob.size()));
+      store_and_swap<uint32_t>(u + 4, extra_guest);
+      break;
+    default: break;
+  }
+}
+
+json ContextsJson(const std::map<uint32_t, uint32_t>& contexts) {
+  json a = json::array();
+  for (const auto& [id, value] : contexts) {
+    a.push_back({{"id", xlive::Hex32(id)}, {"value", value}});
+  }
