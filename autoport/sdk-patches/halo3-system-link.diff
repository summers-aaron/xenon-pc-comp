+uint32_t DetectLocalAddress() {
+  const std::string configured = REXCVAR_GET(net_ip);
+  if (!configured.empty()) {
+    in_addr a{};
+    if (inet_pton(AF_INET, configured.c_str(), &a) == 1) {
+      return ntohl(a.s_addr);
+    }
+    REXSYS_WARN("net_ip '{}' is not an IPv4 address; detecting one", configured);
+  }
+  uint32_t found = 0x7F000001;
+#if !REX_PLATFORM_WIN32
+  ifaddrs* list = nullptr;
+  if (getifaddrs(&list) == 0) {
+    for (ifaddrs* i = list; i; i = i->ifa_next) {
+      if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET || !(i->ifa_flags & IFF_UP) ||
+          (i->ifa_flags & IFF_LOOPBACK)) {
+        continue;
+      }
+      found = ntohl(reinterpret_cast<sockaddr_in*>(i->ifa_addr)->sin_addr.s_addr);
+      break;
+    }
+    freeifaddrs(list);
+  }
+#endif
+  return found;
+}
+
+}  // namespace
+
+uint32_t LocalAddress() {
+  static const uint32_t address = [] {
+    const uint32_t a = DetectLocalAddress();
+    REXSYS_INFO("System link address {}.{}.{}.{}{}", a >> 24, (a >> 16) & 0xFF, (a >> 8) & 0xFF,
+                a & 0xFF, (a >> 24) == 127 ? " (loopback mode)" : "");
+    return a;
+  }();
+  return address;
+}
+
+uint32_t BroadcastAddress() {
+  static const uint32_t address = [] {
+    const uint32_t local = LocalAddress();
+    uint32_t found = INADDR_BROADCAST;
+#if !REX_PLATFORM_WIN32
+    ifaddrs* list = nullptr;
+    if (getifaddrs(&list) == 0) {
+      for (ifaddrs* i = list; i; i = i->ifa_next) {
+        if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET || !(i->ifa_flags & IFF_UP) ||
+            (i->ifa_flags & IFF_LOOPBACK)) {
+          continue;
+        }
+        if (ntohl(reinterpret_cast<sockaddr_in*>(i->ifa_addr)->sin_addr.s_addr) != local) {
+          continue;
+        }
+        if ((i->ifa_flags & IFF_BROADCAST) && i->ifa_broadaddr) {
+          found = ntohl(reinterpret_cast<sockaddr_in*>(i->ifa_broadaddr)->sin_addr.s_addr);
+        }
+        break;
+      }
+      freeifaddrs(list);
+    }
+#endif
+    if (found != INADDR_BROADCAST) {
+      REXSYS_INFO("System link broadcast {}.{}.{}.{}", found >> 24, (found >> 16) & 0xFF,
+                  (found >> 8) & 0xFF, found & 0xFF);
+    }
+    return found;
+  }();
+  return address;
+}
