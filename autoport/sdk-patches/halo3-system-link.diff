new file mode 100644
index 0000000..7c6d340
--- /dev/null
+++ b/src/ui/vulkan/vulkan_gpu_completion_timeline.cpp
@@ -0,0 +1,178 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
