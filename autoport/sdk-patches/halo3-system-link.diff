+
+u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name,
+                             mapped_u32 namelen) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(0x2736);  // WSAENOTSOCK
+    return -1;
+  }
+  sockaddr_in addr{};
+  socklen_t len = sizeof(addr);
+  if (getsockname(int(socket->native_handle()), reinterpret_cast<sockaddr*>(&addr), &len) < 0) {
+    XThread::SetLastError(xnet::LastWsaError());
+    return -1;
+  }
+  name->sin_family = 2;
+  name->sin_port = xnet::ToGuestPort(ntohs(addr.sin_port));
+  // Unbound / wildcard sockets report this instance's address.
+  name->sin_addr = addr.sin_addr.s_addr ? ntohl(addr.sin_addr.s_addr) : xnet::LocalAddress();
+  std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+  if (namelen) {
+    *namelen = sizeof(XSOCKADDR_IN);
+  }
+  return 0;
+}
