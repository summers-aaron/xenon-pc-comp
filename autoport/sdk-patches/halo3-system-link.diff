diff --git a/include/rex/system/xlive.h b/include/rex/system/xlive.h
new file mode 100644
index 0000000..1de316a
--- /dev/null
+++ b/include/rex/system/xlive.h
@@ -0,0 +1,71 @@
+/**
+ * @file        xlive.h
+ * @brief       Client for an Xbox Live stand-in server (halo3-live-phoenix).
+ *
+ * Enabled by the live_server cvar (e.g. "http://127.0.0.1:36080"). When set,
+ * the signed-in profile is reported as signed in to Xbox Live, XAM storage,
+ * title-server (LSP) and XGI session requests are served by the server, and
+ * peers connect directly with the system link networking (xsocket.h).
+ * Protocol: docs/design.md in halo3-live-phoenix.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace rex::system::xlive {
+
+// True when live_server is set.
+bool Enabled();
+
+struct HttpResponse {
+  int status = 0;  // 0: no response (connection failed / timed out)
+  std::string body;
+  bool ok() const { return status >= 200 && status < 300; }
+};
+
+// Blocking HTTP/1.1 request to live_server. path starts with '/'.
+HttpResponse Request(const std::string& method, const std::string& path,
+                     const std::string& body = {},
+                     const std::string& content_type = "application/json");
+
+// The server's IPv4 address (host byte order), resolved from live_server.
+uint32_t ServerAddress();
+// The server's TCP port (from live_server; 80 when not given).
+uint16_t ServerPort();
+
+// A Live account issued by the server: a permanent XUID plus the secret
+// token that proves this profile owns it.
+struct Account {
+  uint64_t xuid = 0;
+  std::string gamertag;
+  std::string token;
+};
+
+// Signs the profile in. With a saved account (`account_file`) the server
+// confirms it (and renames it when `gamertag` changed); without one the
+// server creates an account and it is saved. Every later Request() carries
+// the token. Returns nullopt when offline and nothing is saved.
+std::optional<Account> SignIn(const std::string& gamertag,
+                              const std::filesystem::path& account_file);
+
+// Starts the player registration heartbeat (idempotent).
+void StartPresence(uint64_t xuid, const std::string& gamertag);
+
+// Hex helpers matching the server's conventions.
+std::string Hex64(uint64_t v);
+std::string Hex32(uint32_t v);
+std::optional<uint64_t> ParseHex64(const std::string& s);
+
+// This machine's identity (derived from the system link address).
+uint64_t MachineId();
+std::string MacAddressHex();
+
+std::string Base64Encode(const uint8_t* data, size_t size);
+std::vector<uint8_t> Base64Decode(const std::string& text);
+
+}  // namespace rex::system::xlive
