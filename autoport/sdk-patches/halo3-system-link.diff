+// autoport: GPU frame capture for offline renderer development (xenon-gpu).
+// With AUTOPORT_GPU_CAPTURE=<dir>, touching <dir>/trigger records the next
+// full guest frame (swap to swap) into <dir>/capture_<n>/:
+//   registers.bin     register file at frame start (kRegisterCount u32, host order)
+//   memory_start.bin  guest physical memory (512 MB) at frame start
+//   memory_end.bin    the same at frame end
+//   ring.bin          executed primary ring segments: {u32 ptr, u32 size_bytes,
+//                     u32 read_index, u32 write_index, u32 dword_count, dwords...}
+//   reads.bin         memory the command processor read, as it was when read:
+//                     {u32 kind (1 IB, 2 IM_LOAD, 3 LOAD_ALU_CONSTANT), u32 address,
+//                      u32 dword_count, dwords...} in execution order
+namespace gpu_capture {
+const char* dir = std::getenv("AUTOPORT_GPU_CAPTURE");
+int state = 0;  // 0 idle, 1 recording
+int index = 0;
+FILE* ring = nullptr;
+FILE* reads = nullptr;
+std::string current;
+
+void RecordRead(const memory::Memory* memory, uint32_t kind, uint32_t address, uint32_t dwords) {
+  if (state != 1 || !reads) return;
+  const uint32_t header[3] = {kind, address, dwords};
+  std::fwrite(header, sizeof(header), 1, reads);
+  std::fwrite(memory->TranslatePhysical<const uint32_t*>(address), 4, dwords, reads);
+}
+
+void DumpPhysical(const memory::Memory* memory, const std::string& path) {
+  FILE* f = std::fopen(path.c_str(), "wb");
+  if (!f) return;
+  constexpr size_t kTotal = 0x20000000, kChunk = 0x10000;
+  std::vector<uint8_t> buffer(kChunk);
+  const uint8_t* base = memory->TranslatePhysical<const uint8_t*>(0);
+  for (size_t off = 0; off < kTotal; off += kChunk) {
+    iovec local{buffer.data(), kChunk};
+    iovec remote{const_cast<uint8_t*>(base + off), kChunk};
+    if (process_vm_readv(getpid(), &local, 1, &remote, 1, 0) != ssize_t(kChunk)) {
+      std::fill(buffer.begin(), buffer.end(), uint8_t(0));  // unreadable range
+    }
+    std::fwrite(buffer.data(), 1, kChunk, f);
+  }
+  std::fclose(f);
+}
+
+void OnSwap(const RegisterFile& registers, const memory::Memory* memory) {
+  if (!dir) return;
+  if (state == 1) {
+    std::fclose(ring);
+    ring = nullptr;
+    if (reads) std::fclose(reads);
+    reads = nullptr;
+    DumpPhysical(memory, current + "/memory_end.bin");
+    state = 0;
+    REXGPU_INFO("GPU capture written to {}", current);
+    return;
+  }
+  const std::string trigger = std::string(dir) + "/trigger";
+  if (std::remove(trigger.c_str()) != 0) return;  // not requested
+  current = std::string(dir) + "/capture_" + std::to_string(index++);
+  std::filesystem::create_directories(current);
+  if (FILE* f = std::fopen((current + "/registers.bin").c_str(), "wb")) {
+    std::fwrite(registers.values, sizeof(uint32_t), RegisterFile::kRegisterCount, f);
+    std::fclose(f);
+  }
+  DumpPhysical(memory, current + "/memory_start.bin");
+  ring = std::fopen((current + "/ring.bin").c_str(), "wb");
+  reads = std::fopen((current + "/reads.bin").c_str(), "wb");
+  state = ring ? 1 : 0;
+}
+
+void OnPrimary(const memory::Memory* memory, uint32_t ptr, uint32_t size_bytes, uint32_t read_index,
+               uint32_t write_index) {
+  if (state != 1 || !ring) return;
+  const uint32_t dwords_total = size_bytes / 4;
+  uint32_t count = (write_index + dwords_total - read_index) % dwords_total;
+  const uint32_t header[5] = {ptr, size_bytes, read_index, write_index, count};
+  std::fwrite(header, sizeof(header), 1, ring);
+  const uint32_t* base = memory->TranslatePhysical<const uint32_t*>(ptr);
+  for (uint32_t i = 0; i < count; ++i) {
+    std::fwrite(&base[(read_index + i) % dwords_total], 4, 1, ring);
+  }
+}
