+// Frees the XamAlloc block that contains `address`, if any - unless it also
+// contains `keep` (e.g. results the title reads after completion).
+bool XamFreeContaining(uint32_t address, uint32_t keep) {
+  uint32_t ptr = 0;
+  {
+    std::lock_guard<std::mutex> lock(xam_alloc_mutex);
+    auto it = xam_alloc_live.upper_bound(address);
+    if (!address || it == xam_alloc_live.begin()) {
