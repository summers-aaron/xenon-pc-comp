+void OnQosListen(system::KernelState* ks, uint64_t xnkid, bool enabled) {
+  if (!xlive::Enabled()) {
+    return;
+  }
+  uint64_t id = 0;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    for (auto& [obj, s] : sessions) {
+      if (s.host && s.id == xnkid && s.qos_reported != int(enabled)) {
+        s.qos_reported = int(enabled);
+        id = s.id;
+        break;
+      }
+    }
+  }
+  if (id) {
+    Call("POST", SessionPath(ks, id) + "/modify", {{"qosEnabled", enabled}});
+  }
+}
+
+uint32_t CreateSessionHandle() {
+  return next_handle.fetch_add(1);
+}
+
+uint32_t SessionObjectForHandle(system::KernelState* ks, uint32_t handle) {
+  std::lock_guard<std::mutex> lock(mutex);
+  auto it = handle_objects.find(handle);
+  if (it != handle_objects.end()) {
+    return it->second;
+  }
+  const uint32_t obj = ks->memory()->SystemHeapAlloc(16);
+  std::memset(ks->memory()->TranslateVirtual<uint8_t*>(obj), 0, 16);
+  store_and_swap<uint32_t>(ks->memory()->TranslateVirtual<uint8_t*>(obj), handle);
+  handle_objects[handle] = obj;
+  return obj;
+}
+
+std::optional<X_HRESULT> Dispatch(system::KernelState* ks, uint32_t message, uint32_t buffer_ptr,
+                                  uint32_t buffer_length) {
+  if (!xlive::Enabled() || !buffer_ptr) {
+    return std::nullopt;
+  }
+  auto* mem = ks->memory();
+  uint8_t* b = mem->TranslateVirtual<uint8_t*>(buffer_ptr);
+  auto u32 = [b](size_t off) { return load_and_swap<uint32_t>(b + off); };
+
+  switch (message) {
+    case 0x000B0006: {  // XUserSetContext
+      const uint32_t user = u32(0);
+      if (user < 4) {
+        std::lock_guard<std::mutex> lock(mutex);
+        users[user].contexts[u32(16)] = u32(20);
+      }
+      PushUserData(ks, user);
+      return X_E_SUCCESS;
+    }
+    case 0x000B0007: {  // XUserSetProperty
+      const uint32_t user = u32(0);
+      const uint32_t id = u32(16), size = u32(20), ptr = u32(24);
+      if (user < 4) {
+        const uint8_t* value = ptr ? mem->TranslateVirtual<uint8_t*>(ptr) : nullptr;
+        std::lock_guard<std::mutex> lock(mutex);
+        users[user].properties[id] = PropertyFromRaw(id, value, size);
+      }
+      PushUserData(ks, user);
+      return X_E_SUCCESS;
+    }
+    case 0x000B0041: {  // XUserGetContext
+      const uint32_t user = u32(0), ctx_ptr = u32(16);
+      if (user >= 4 || !ctx_ptr) return std::nullopt;
+      uint8_t* ctx = mem->TranslateVirtual<uint8_t*>(ctx_ptr);
+      std::lock_guard<std::mutex> lock(mutex);
+      auto it = users[user].contexts.find(load_and_swap<uint32_t>(ctx));
+      if (it == users[user].contexts.end()) return std::nullopt;
+      store_and_swap<uint32_t>(ctx + 4, it->second);
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0010: {  // XSessionCreate
+      const uint32_t obj = u32(0), flags = u32(4);
+      if (!(flags & kFlagsLive)) {
+        return std::nullopt;  // system link / local session
+      }
+      Session s;
+      s.flags = flags;
+      s.public_slots = u32(8);
+      s.private_slots = u32(12);
+      s.user_index = u32(16);
+      s.host = (flags & kFlagHost) != 0;
+      const uint32_t info_ptr = u32(20), nonce_ptr = u32(24);
+      uint8_t* info = info_ptr ? mem->TranslateVirtual<uint8_t*>(info_ptr) : nullptr;
+      if (s.host) {
+        if (info) {
+          if (!LoadXnkid(info)) {
+            // XNKID_ONLINE_PEER: top nibble 8.
+            store_and_swap<uint64_t>(info, (Random64() & 0x0FFFFFFFFFFFFFFFull) | 0x8000000000000000ull);
+          }
+          WriteOwnXnAddr(info + 8);
+          uint64_t zero[2] = {};
+          if (!std::memcmp(info + 0x2C, zero, 16)) {
+            store_and_swap<uint64_t>(info + 0x2C, Random64());
+            store_and_swap<uint64_t>(info + 0x34, Random64());
+          }
+        }
+        s.nonce = Random64();
+        if (nonce_ptr) store_and_swap<uint64_t>(mem->TranslateVirtual<uint8_t*>(nonce_ptr), s.nonce);
+      }
+      if (info) {
+        std::memcpy(s.info, info, kInfoSize);
+        s.id = LoadXnkid(info);
+      }
+      if (s.host) {
+        json body = HostFields(ks, s);
+        body["sessionId"] = xlive::Hex64(s.id);
+        body["flags"] = s.flags;
+        body["publicSlots"] = s.public_slots;
+        body["privateSlots"] = s.private_slots;
+        {
+          std::lock_guard<std::mutex> lock(mutex);
+          const UserData& u = users[s.user_index < 4 ? s.user_index : 0];
+          body["properties"] = PropertiesJson(u.properties);
+          body["contexts"] = ContextsJson(u.contexts);
+        }
+        if (!Call("POST", TitlePath(ks) + "/sessions", body)) {
+          return X_E_FAIL;
+        }
+      }
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        sessions[obj] = s;
+      }
+      REXKRNL_INFO("xlive: XSessionCreate {} {:016X} flags {:#x} slots {}/{}",
+                   s.host ? "host" : "join", s.id, s.flags, s.public_slots, s.private_slots);
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0011: {  // XSessionDelete
+      Session s;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* found = Find(u32(0));
+        if (!found) return std::nullopt;
+        s = *found;
+        sessions.erase(u32(0));
+      }
+      if (s.host) {
+        Call("DELETE", SessionPath(ks, s.id), json());
+      } else {
+        Call("POST", SessionPath(ks, s.id) + "/leave",
+             {{"xuids", json::array({xlive::Hex64(OurXuid(ks))})}});
+      }
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0012:    // XSessionJoinLocal / JoinRemote
+    case 0x000B0013: {  // XSessionLeaveLocal / LeaveRemote
+      uint64_t id;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* s = Find(u32(0));
+        if (!s) return std::nullopt;
+        id = s->id;
+      }
+      const auto members = Members(ks, u32(4), u32(8), u32(12), message == 0x000B0012 ? u32(16) : 0);
+      if (members.empty()) return X_E_SUCCESS;
+      if (message == 0x000B0012) {
+        Call("POST", SessionPath(ks, id) + "/join", {{"players", members}});
+      } else {
+        json xuids = json::array();
+        for (const auto& m : members) xuids.push_back(m["xuid"]);
+        Call("POST", SessionPath(ks, id) + "/leave", {{"xuids", xuids}});
+      }
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0014:    // XSessionStart
+    case 0x000B0015: {  // XSessionEnd
+      uint64_t id;
+      bool host;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* s = Find(u32(0));
+        if (!s) return std::nullopt;
+        id = s->id;
+        host = s->host;
+      }
+      if (host) {
+        Call("POST", SessionPath(ks, id) + (message == 0x000B0014 ? "/start" : "/end"),
+             json::object());
+      }
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0018: {  // XSessionModify
+      uint64_t id;
+      bool host;
+      uint32_t flags;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* s = Find(u32(0));
+        if (!s) return std::nullopt;
+        // XSessionModify changes only the join/invite options
+        // (INVITES_DISABLED, JOIN_VIA_PRESENCE_DISABLED,
+        // JOIN_IN_PROGRESS_DISABLED, JOIN_VIA_PRESENCE_FRIENDS_ONLY); the
+        // session type flags stay.
+        constexpr uint32_t kModifiable = 0x100 | 0x200 | 0x400 | 0x800;
+        s->flags = (s->flags & ~kModifiable) | (u32(4) & kModifiable);
+        s->public_slots = u32(8);
+        s->private_slots = u32(12);
+        id = s->id;
+        host = s->host;
+        flags = s->flags;
+      }
+      if (host) {
+        Call("POST", SessionPath(ks, id) + "/modify",
+             {{"flags", flags}, {"publicSlots", u32(8)}, {"privateSlots", u32(12)}});
+      }
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0016:    // XSessionSearch
+    case 0x000B001C: {  // XSessionSearchEx
+      const uint32_t num_users = message == 0x000B001C ? u32(32) : 1;
+      const json body = SearchBody(ks, u32(0), u32(8), num_users, load_and_swap<uint16_t>(b + 12),
+                                   u32(16), load_and_swap<uint16_t>(b + 14), u32(20));
+      return Search(ks, body, u32(28), u32(24));
+    }
+    case 0x000B0065: {  // XSessionSearchWeighted: weights ignored, non-weighted filters kept
+      const json body = SearchBody(ks, u32(0), u32(8), u32(44), load_and_swap<uint16_t>(b + 24),
+                                   u32(28), load_and_swap<uint16_t>(b + 26), u32(32));
+      return Search(ks, body, u32(40), u32(36));
+    }
+
+    case 0x000B001B:    // XSessionSearchByID / ByIDs
+    case 0x000B0060: {
+      std::vector<uint64_t> ids;
+      uint32_t results_ptr, buffer_size;
+      if (buffer_length == 20) {  // user, XNKID, size, results
+        ids.push_back(LoadXnkid(b + 4));
+        buffer_size = u32(12);
+        results_ptr = u32(16);
+      } else {  // user, count, ids ptr, size, results
+        for (uint32_t i = 0; i < u32(4) && i < 100; ++i) {
+          ids.push_back(LoadXnkid(mem->TranslateVirtual<uint8_t*>(u32(8) + i * 8)));
+        }
+        buffer_size = u32(12);
+        results_ptr = u32(16);
+      }
+      json list = json::array();
+      for (uint64_t id : ids) {
+        if (auto s = Call("GET", SessionPath(ks, id), json())) list.push_back(*s);
+      }
+      WriteSearchResults(ks, list, results_ptr, buffer_size);
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B001D: {  // XSessionGetDetails
+      Session s;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* found = Find(u32(0));
+        if (!found) return std::nullopt;
+        s = *found;
+      }
+      const uint32_t size = u32(4), details_ptr = u32(8);
+      auto remote = Call("GET", SessionPath(ks, s.id), json());
+      if (!remote || !details_ptr || size < 0x80) return X_E_FAIL;
+      uint8_t* d = mem->TranslateVirtual<uint8_t*>(details_ptr);
+      std::memset(d, 0, 0x80);
+      uint32_t game_type = 0, game_mode = 0;
+      for (const auto& c : remote->value("contexts", json::array())) {
+        const uint32_t cid = uint32_t(xlive::ParseHex64(c.value("id", "0")).value_or(0));
+        if (cid == kContextGameType) game_type = c.value("value", 0u);
+        if (cid == kContextGameMode) game_mode = c.value("value", 0u);
+      }
+      const std::string state = remote->value("state", "lobby");
+      const auto players = remote->value("players", json::array());
+      const uint32_t fit = std::min<uint32_t>(uint32_t(players.size()), (size - 0x80) / 0x10);
+      store_and_swap<uint32_t>(d + 0, s.host ? s.user_index : kUserIndexNone);
+      store_and_swap<uint32_t>(d + 4, game_type);
+      store_and_swap<uint32_t>(d + 8, game_mode);
+      store_and_swap<uint32_t>(d + 12, remote->value("flags", s.flags));
+      store_and_swap<uint32_t>(d + 16, remote->value("publicSlots", s.public_slots));
+      store_and_swap<uint32_t>(d + 20, remote->value("privateSlots", s.private_slots));
+      store_and_swap<uint32_t>(d + 24, remote->value("openPublicSlots", 0u));
+      store_and_swap<uint32_t>(d + 28, remote->value("openPrivateSlots", 0u));
+      store_and_swap<uint32_t>(d + 32, uint32_t(players.size()));
+      store_and_swap<uint32_t>(d + 36, fit);
+      store_and_swap<uint32_t>(d + 40, state == "in_game" ? 2u : state == "ended" ? 3u : 0u);
+      store_and_swap<uint64_t>(d + 48, s.nonce);
+      std::memcpy(d + 56, s.info, kInfoSize);
+      store_and_swap<uint64_t>(d + 116, s.id);
+      const uint32_t members_ptr = details_ptr + 0x80;
+      for (uint32_t i = 0; i < fit; ++i) {
+        uint8_t* m = mem->TranslateVirtual<uint8_t*>(members_ptr + i * 0x10);
+        const uint64_t xuid = xlive::ParseHex64(players[i].value("xuid", "0")).value_or(0);
+        store_and_swap<uint64_t>(m + 0, xuid);
+        store_and_swap<uint32_t>(m + 8, xuid == OurXuid(ks) ? 0u : kUserIndexNone);
+        store_and_swap<uint32_t>(m + 12, players[i].value("private", false) ? 1u : 0u);
+      }
+      store_and_swap<uint32_t>(d + 124, fit ? members_ptr : 0);
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B001E: {  // XSessionMigrateHost: this instance becomes the host
+      Session s;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* found = Find(u32(0));
+        if (!found) return std::nullopt;
+        WriteOwnXnAddr(found->info + 8);
+        found->host = true;
+        found->user_index = u32(8);
+        s = *found;
+      }
+      if (u32(4)) {
+        std::memcpy(mem->TranslateVirtual<uint8_t*>(u32(4)), s.info, kInfoSize);
+      }
+      Call("POST", SessionPath(ks, s.id) + "/migrate", HostFields(ks, s));
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B001A: {  // XSessionArbitrationRegister
+      Session s;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* found = Find(u32(0));
+        if (!found) return std::nullopt;
+        s = *found;
+      }
+      const uint64_t nonce = load_and_swap<uint64_t>(b + 8);
+      const uint32_t size = u32(20), results_ptr = u32(24);
+      auto r = Call("POST", SessionPath(ks, s.id) + "/arbitration",
+                    {{"nonce", xlive::Hex64(nonce)}});
+      if (!r || !results_ptr || size < 8) return X_E_FAIL;
+      // XSESSION_REGISTRATION_RESULTS, then registrants, then their XUIDs.
+      const auto machines = r->value("machines", json::array());
+      uint8_t* res = mem->TranslateVirtual<uint8_t*>(results_ptr);
+      std::memset(res, 0, size);
+      uint32_t count = 0;
+      uint32_t xuid_guest = results_ptr + 8 + uint32_t(machines.size()) * 0x18;
+      for (const auto& m : machines) {
+        const auto players = m.value("players", json::array());
+        if (xuid_guest + players.size() * 8 > results_ptr + size) break;
+        uint8_t* reg = res + 8 + count * 0x18;
+        store_and_swap<uint64_t>(reg + 0, xlive::ParseHex64(m.value("machineId", "0")).value_or(0));
+        store_and_swap<uint32_t>(reg + 8, 1);  // trustworthiness
+        store_and_swap<uint32_t>(reg + 12, uint32_t(players.size()));
+        store_and_swap<uint32_t>(reg + 16, xuid_guest);
+        for (const auto& x : players) {
+          store_and_swap<uint64_t>(mem->TranslateVirtual<uint8_t*>(xuid_guest),
+                                   xlive::ParseHex64(x.get<std::string>()).value_or(0));
+          xuid_guest += 8;
+        }
+        ++count;
+      }
+      store_and_swap<uint32_t>(res + 0, count);
+      store_and_swap<uint32_t>(res + 4, count ? results_ptr + 8 : 0);
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B0025:    // XSessionWriteStats
+    case 0x000B0026: {  // XSessionFlushStats
+      uint64_t id;
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        Session* s = Find(u32(0));
+        if (!s) return std::nullopt;
+        id = s->id;
+      }
+      // XGI_STATS_WRITE { obj_ptr; pad; xuid (+8); num_views (+16); views_ptr (+20) },
+      // views: XSESSION_VIEW_PROPERTIES { view_id; properties_count; properties_ptr }.
+      json views = json::array();
+      if (message == 0x000B0025) {
+        const uint32_t num_views = std::min<uint32_t>(u32(16), 64), views_ptr = u32(20);
+        for (uint32_t i = 0; views_ptr && i < num_views; ++i) {
+          const uint8_t* v = mem->TranslateVirtual<uint8_t*>(views_ptr + i * 12);
+          const uint32_t count = std::min<uint32_t>(load_and_swap<uint32_t>(v + 4), 256);
+          const uint32_t props_ptr = load_and_swap<uint32_t>(v + 8);
+          json properties = json::array();
+          for (uint32_t k = 0; props_ptr && k < count; ++k) {
+            properties.push_back(PropertyJson(ReadGuestProperty(
+                ks, mem->TranslateVirtual<uint8_t*>(props_ptr + k * uint32_t(kPropertySize)))));
+          }
+          views.push_back({{"viewId", load_and_swap<uint32_t>(v + 0)}, {"properties", properties}});
+        }
+      }
+      json body = {{"flush", message == 0x000B0026}, {"views", views}};
+      if (message == 0x000B0025) {
+        body["xuid"] = xlive::Hex64(load_and_swap<uint64_t>(b + 8));
+      }
+      Call("POST", SessionPath(ks, id) + "/stats", body);
+      return X_E_SUCCESS;
+    }
+
+    case 0x000B001F:  // XSessionModifySkill
+      return X_E_SUCCESS;
+
+    case 0x000B0021: {  // XUserReadStats: no stats kept yet; every view is empty
+      // XUSER_STATS_READ_RESULTS { dwNumViews; pViews } followed by
+      // XUSER_STATS_VIEW { dwViewId; dwTotalViewRows; dwNumRows; pRows }.
+      const uint32_t specs_count = u32(12), specs_ptr = u32(16);
+      const uint32_t size = u32(20), results_ptr = u32(24);
+      if (!results_ptr || size < 8) return X_E_SUCCESS;
+      const uint32_t views = std::min<uint32_t>(specs_count, (size - 8) / 16);
+      uint8_t* res = mem->TranslateVirtual<uint8_t*>(results_ptr);
+      std::memset(res, 0, 8 + views * 16);
+      store_and_swap<uint32_t>(res + 0, views);
+      store_and_swap<uint32_t>(res + 4, views ? results_ptr + 8 : 0);
+      for (uint32_t i = 0; i < views; ++i) {
+        // XUSER_STATS_SPEC: dwViewId, dwNumColumnIds, rgwColumnIds[64] (0x88 bytes)
+        const uint32_t view_id =
+            specs_ptr ? load_and_swap<uint32_t>(mem->TranslateVirtual<uint8_t*>(specs_ptr + i * 0x88)) : 0;
+        store_and_swap<uint32_t>(res + 8 + i * 16, view_id);
+      }
+      return X_E_SUCCESS;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace rex::kernel::xam::xgi_live
diff --git a/src/kernel/xam/apps/xgi_live.h b/src/kernel/xam/apps/xgi_live.h
new file mode 100644
index 0000000..4e3fd99
--- /dev/null
+++ b/src/kernel/xam/apps/xgi_live.h
@@ -0,0 +1,33 @@
+/**
+ * @file        xgi_live.h
+ * @brief       XGI sessions (XSession*) backed by the Xbox Live stand-in
+ *              server (rex::system::xlive). Used by XgiApp when live_server
+ *              is set; system link and offline sessions keep the local path.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+#include <rex/system/kernel_state.h>
+#include <rex/system/xtypes.h>
+
+namespace rex::kernel::xam::xgi_live {
+
+// XamSessionCreateHandle / XamSessionRefObjByHandle: unique handles, each with
+// a guest X_KSESSION { be<u32> handle } the XGI messages refer to.
+uint32_t CreateSessionHandle();
+uint32_t SessionObjectForHandle(system::KernelState* kernel_state, uint32_t handle);
+
+// XNetQosListen changed the enabled state for `xnkid` (big-endian value):
+// tells the server when it is a Live session this instance hosts, so search
+// only returns sessions whose host answers QoS probes.
+void OnQosListen(system::KernelState* kernel_state, uint64_t xnkid, bool enabled);
+
+// Handles one XGI message when it concerns the Live server; nullopt means
+// "not a Live request, use the local implementation".
+std::optional<X_HRESULT> Dispatch(system::KernelState* kernel_state, uint32_t message,
+                                  uint32_t buffer_ptr, uint32_t buffer_length);
+
+}  // namespace rex::kernel::xam::xgi_live
