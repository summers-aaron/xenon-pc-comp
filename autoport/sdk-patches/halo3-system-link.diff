+std::string FormatAddress(uint32_t ip, uint16_t port) {
+  return fmt::format("{}.{}.{}.{}:{}", ip >> 24, (ip >> 16) & 0xFF, (ip >> 8) & 0xFF, ip & 0xFF,
+                     port);
+}
