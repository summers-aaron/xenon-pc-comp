+// autoport: PM4 census for the native GPU work - what a title sends to the GPU
+// per frame. Enabled with AUTOPORT_PM4_STATS=<file>; a report is written every
+// 300 guest swaps. Only touched on the command processor thread.
+namespace pm4_census {
+struct Stats {
+  uint64_t frames = 0;
+  uint64_t type3_ring[128] = {};
+  uint64_t type3_indirect[128] = {};
+  uint64_t type0_packets = 0, type0_writes = 0, type1_packets = 0;
+  uint64_t reg_writes_by_range[8] = {};  // 0x0000-0x1FFF, 0x2000 ctx, 0x2100, 0x2200, 0x2300+, 0x4000 ALU, 0x4800 fetch/bool/loop, other
+  uint64_t indirect_buffers = 0, indirect_dwords = 0;
