 // http://mb.mirage.org/bugzilla/xliveless/main.c
 
 X_HRESULT XLiveBaseApp::DispatchMessageSync(uint32_t message, uint32_t buffer_ptr,
                                             uint32_t buffer_length) {
+  return Dispatch(message, buffer_ptr, buffer_length, nullptr);
+}
+
+X_HRESULT XLiveBaseApp::DispatchMessageAsync(uint32_t message, uint32_t buffer_ptr,
+                                             uint32_t buffer_length, uint32_t* extended_error) {
+  return Dispatch(message, buffer_ptr, buffer_length, extended_error);
+}
+
+X_HRESULT XLiveBaseApp::Dispatch(uint32_t message, uint32_t buffer_ptr, uint32_t buffer_length,
+                                 uint32_t* extended_error) {
+  // XLiveBase async requests (XStorage*, XStringVerify, ...) arrive as a
+  // message pointing at an XLIVE_ASYNC_TASK the title's XAPI allocated with
+  // XamAlloc. XAM frees it when the request completes; the title never does
+  // (Halo 3 leaked ~25 XStringVerify blocks a second until XamAlloc failed).
+  const bool async_task = message >= 0x00050008 && message <= 0x0005000C;
+  uint32_t task_ptr = 0, results_ptr = 0;
+  if (async_task && buffer_ptr) {
+    task_ptr = load_and_swap<uint32_t>(memory_->TranslateVirtual(buffer_ptr));
+    if (task_ptr) {
+      results_ptr = memory_->TranslateVirtual<XLIVE_ASYNC_TASK*>(task_ptr)->results_ptr;
+    }
+  }
+  const X_HRESULT result = DispatchTask(message, buffer_ptr, buffer_length, extended_error);
+  if (async_task) {
+    XamFreeContaining(task_ptr, results_ptr);
+    XamFreeContaining(buffer_ptr, results_ptr);
+  }
+  return result;
+}
+
+X_HRESULT XLiveBaseApp::DispatchTask(uint32_t message, uint32_t buffer_ptr, uint32_t buffer_length,
+                                     uint32_t* extended_error) {
   // NOTE: buffer_length may be zero or valid.
   auto buffer = memory_->TranslateVirtual(buffer_ptr);
+  if (xlive::Enabled()) {
+    switch (message) {
+      case 0x00058003:
+        // XLiveBaseLogonGetHR: signed in to Live.
+        REXKRNL_DEBUG("XLiveBaseLogonGetHR({:08X}, {:08X})", buffer_ptr, buffer_length);
+        return X_E_SUCCESS;
+      case 0x00050008:
+        return XStorageDelete(buffer_ptr);
+      case 0x00050009:
+        return XStorageDownloadToMemory(buffer_ptr, extended_error);
+      case 0x0005000A:
+        return XStorageEnumerate(buffer_ptr, extended_error);
+      case 0x0005000B:
+        return XStorageUploadFromMemory(buffer_ptr);
+      case 0x0005000C:
+        return XStringVerify(buffer_ptr);
+      case 0x00058032:
+        return XOnlineGetTaskProgress(buffer_ptr);
+      case 0x00058035:
+        return XStorageBuildServerPath(buffer_ptr);
+      default:
+        break;
+    }
+  }
   switch (message) {
     case 0x00058004: {
       // Called on startup, seems to just return a bool in the buffer.
@@ -85,6 +495,354 @@ X_HRESULT XLiveBaseApp::DispatchMessageSync(uint32_t message, uint32_t buffer_pt
   return X_E_FAIL;
 }
 
+X_HRESULT XLiveBaseApp::XStorageBuildServerPath(uint32_t buffer_ptr) {
+  if (!buffer_ptr) {
+    return X_E_INVALIDARG;
+  }
+  auto* args = memory_->TranslateVirtual<X_STORAGE_BUILD_SERVER_PATH*>(buffer_ptr);
+  const uint32_t user_index = args->user_index;
+  uint64_t xuid = 0;
+  if (user_index == kUserIndexNone) {
+    xuid = args->xuid;
+  } else if (user_index < 4 && kernel_state_->user_profile()) {
+    xuid = kernel_state_->user_profile()->xuid();
+  } else {
+    return X_E_INVALIDARG;
+  }
+  if (!xuid) {
+    return user_index == kUserIndexNone ? X_E_INVALIDARG : kOnlineLogonNotLoggedOn;
+  }
+  if (!args->server_path_length_ptr) {
+    return X_E_INVALIDARG;
+  }
+  const std::string filename =
+      args->file_name_ptr
+          ? ReadGuestString(memory_->TranslateVirtual(args->file_name_ptr), kMaxPathnameLength)
+          : std::string();
+  const uint32_t title_id = kernel_state_->title_id();
+  std::string path;
+  switch (uint32_t(args->storage_location)) {
+    case kFacilityGameClip: {
+      if (!args->storage_location_info_ptr || args->storage_location_info_size != 4) {
+        return X_E_INVALIDARG;
+      }
+      const uint32_t view_id =
+          load_and_swap<uint32_t>(memory_->TranslateVirtual(args->storage_location_info_ptr));
+      path = fmt::format("//xestats/u:{:016x}/{:08x}/{:08x}", xuid, title_id, view_id);
+      break;
+    }
+    case kFacilityPerTitle:
+      if (args->storage_location_info_ptr || args->storage_location_info_size || filename.empty()) {
+        return X_E_INVALIDARG;
+      }
+      path = fmt::format("//title.{:08x}/t:{:08x}/{}", title_id, title_id, filename);
+      break;
+    case kFacilityPerUserTitle:
+      if (args->storage_location_info_ptr || args->storage_location_info_size || filename.empty()) {
+        return X_E_INVALIDARG;
+      }
+      path = fmt::format("//tuser.{:08x}/u:{:016x}/{:08x}/{}", title_id, xuid, title_id, filename);
+      break;
+    default:
+      return kStorageInvalidFacility;
+  }
+  // Lengths are in characters, including the terminator.
+  auto* length_ptr = memory_->TranslateVirtual(args->server_path_length_ptr);
+  const uint32_t needed = uint32_t(path.size()) + 1;
+  if (args->server_path_ptr) {
+    const uint32_t capacity = load_and_swap<uint32_t>(length_ptr);
+    if (capacity < needed) {
+      return X_E_INVALIDARG;
+    }
+    WriteGuestString(memory_->TranslateVirtual(args->server_path_ptr), path, capacity);
+  }
+  store_and_swap<uint32_t>(length_ptr, needed);
+  if (REXCVAR_GET(net_log)) {
+    REXKRNL_INFO("xlive: storage path {} -> {}", filename, path);
+  }
+  return X_E_SUCCESS;
+}
+
+X_HRESULT XLiveBaseApp::XStorageDownloadToMemory(uint32_t buffer_ptr, uint32_t* extended_error) {
+  // user index, path, buffer size, buffer
+  MarshalledRequest request(memory_, buffer_ptr);
+  uint32_t user_index;
+  std::string guest_path;
+  if (!request.valid() || !request.results_ptr() ||
+      request.results_size() < kDownloadResultsSize ||
+      !request.ReadUserAndPath(&user_index, &guest_path)) {
+    return X_E_INVALIDARG;
+  }
+  const uint32_t buffer_size = request.ReadU32();
+  const uint32_t buffer_address = request.ReadU32();
+  if (request.overrun() || !buffer_address) {
+    return X_E_INVALIDARG;
+  }
+  const auto http_path = GuestPathToHttp(guest_path);
+  if (!http_path) {
+    REXKRNL_WARN("xlive: storage download: unsupported path {}", guest_path);
+    return kStorageInvalidStoragePath;
+  }
+  auto* results = memory_->TranslateVirtual(request.results_ptr());
+  std::memset(results, 0, request.results_size());
+
+  const auto response = xlive::Request("GET", *http_path);
+  LogStorage("GET", *http_path, response.status, response.body.size());
+  auto fail = [extended_error](X_HRESULT extended) -> X_HRESULT {
+    // Titles expect X_ERROR_FUNCTION_FAILED with the reason as the extended
+    // error (e.g. 545107D1 on a missing file).
+    if (extended_error) {
+      *extended_error = extended;
+    }
+    return X_ERROR_FUNCTION_FAILED;
+  };
+  if (response.status == 404) {
+    return fail(kStorageFileNotFound);
+  }
+  if (!response.ok()) {
+    return fail(X_E_FAIL);
+  }
+  if (response.body.size() > buffer_size) {
+    REXKRNL_WARN("xlive: storage {} is {} bytes, buffer {}", *http_path, response.body.size(),
+                 buffer_size);
+    return fail(X_HRESULT_FROM_WIN32(X_ERROR_INSUFFICIENT_BUFFER));
+  }
+  std::memcpy(memory_->TranslateVirtual(buffer_address), response.body.data(),
+              response.body.size());
+  // The owner is only known for user and clip paths.
+  uint64_t owner = 0;
+  if (guest_path.rfind("//", 0) == 0) {
+    // Built by GuestPathToHttp, so the XUID is at a fixed offset.
+    if (http_path->rfind("/storage/user/", 0) == 0) {
+      owner = xlive::ParseHex64(http_path->substr(14, 16)).value_or(0);
+    } else if (http_path->rfind("/storage/clip/", 0) == 0) {
+      owner = xlive::ParseHex64(http_path->substr(23, 16)).value_or(0);
+    }
+  }
+  store_and_swap<uint32_t>(results + 0x0, uint32_t(response.body.size()));  // bytes_total
+  store_and_swap<uint64_t>(results + 0x4, owner);                           // xuid_owner
+  store_and_swap<uint64_t>(results + 0xC, UnixToFiletime(std::time(nullptr)));  // ft_created
+  return X_E_SUCCESS;
+}
+
+X_HRESULT XLiveBaseApp::XStorageUploadFromMemory(uint32_t buffer_ptr) {
+  // user index, path, buffer size, buffer
+  MarshalledRequest request(memory_, buffer_ptr);
+  uint32_t user_index;
+  std::string guest_path;
+  if (!request.valid() || !request.ReadUserAndPath(&user_index, &guest_path)) {
+    return X_E_INVALIDARG;
+  }
+  const uint32_t buffer_size = request.ReadU32();
+  const uint32_t buffer_address = request.ReadU32();
+  if (request.overrun() || (buffer_size && !buffer_address)) {
+    return X_E_INVALIDARG;
+  }
+  const auto http_path = GuestPathToHttp(guest_path);
+  if (!http_path) {
+    REXKRNL_WARN("xlive: storage upload: unsupported path {}", guest_path);
+    return kStorageInvalidStoragePath;
+  }
+  const std::string body(
+      buffer_size ? reinterpret_cast<const char*>(memory_->TranslateVirtual(buffer_address))
+                  : "",
+      buffer_size);
+  const auto response = xlive::Request("PUT", *http_path, body, "application/octet-stream");
+  LogStorage("PUT", *http_path, response.status, body.size());
+  if (response.status == 304) {
+    return kStorageFileNotModified;
+  }
+  if (response.status == 413) {
+    return kStorageFileIsTooBig;
+  }
+  return response.ok() ? X_E_SUCCESS : X_E_FAIL;
+}
+
+X_HRESULT XLiveBaseApp::XStorageDelete(uint32_t buffer_ptr) {
+  MarshalledRequest request(memory_, buffer_ptr);
+  uint32_t user_index;
+  std::string guest_path;
+  if (!request.valid() || !request.ReadUserAndPath(&user_index, &guest_path)) {
+    return X_E_INVALIDARG;
+  }
+  const auto http_path = GuestPathToHttp(guest_path);
+  if (!http_path) {
+    return kStorageInvalidStoragePath;
+  }
+  const auto response = xlive::Request("DELETE", *http_path);
+  LogStorage("DELETE", *http_path, response.status, 0);
+  if (response.status == 404) {
+    return kStorageFileNotFound;
+  }
+  return response.ok() ? X_E_SUCCESS : X_E_FAIL;
+}
+
+X_HRESULT XLiveBaseApp::XStorageEnumerate(uint32_t buffer_ptr, uint32_t* extended_error) {
+  // user index, path, starting index, max results
+  MarshalledRequest request(memory_, buffer_ptr);
+  uint32_t user_index;
+  std::string guest_path;
+  if (!request.valid() || !request.results_ptr() ||
+      !request.ReadUserAndPath(&user_index, &guest_path)) {
+    return X_E_INVALIDARG;
+  }
+  const uint32_t starting_index = request.ReadU32();
+  const uint32_t max_results = request.ReadU32();
+  if (request.overrun() || max_results > kMaxResultsToReturn ||
+      starting_index >= kMaxResultsToReturn) {
+    return X_E_INVALIDARG;
+  }
+  const uint32_t results_size = request.results_size();
+  const uint32_t item_space = kFileInfoSize + kMaxPathnameLength * 2;
+  const uint32_t capacity =
+      results_size > kEnumerateResultsSize ? (results_size - kEnumerateResultsSize) / item_space
+                                           : 0;
+  if (!capacity) {
+    return X_E_INVALIDARG;
+  }
+  const bool facility_path = guest_path.rfind("//", 0) == 0;
+  // Wildcards ("/*.bin") enumerate the directory; the server matches prefixes.
+  std::string prefix = guest_path;
+  if (const size_t star = prefix.find('*'); star != std::string::npos) {
+    prefix.resize(star);
+  }
+  std::optional<std::string> http_prefix;
+  if (facility_path && !prefix.empty() && prefix.back() == '/') {
+    // A directory: map it with a placeholder file name and strip it again.
+    http_prefix = GuestPathToHttp(prefix + "x");
+    if (http_prefix) {
+      http_prefix->pop_back();
+    }
+  } else {
+    http_prefix = GuestPathToHttp(prefix);
+  }
+  if (!http_prefix) {
+    REXKRNL_WARN("xlive: storage enumerate: unsupported path {}", guest_path);
+    return kStorageInvalidStoragePath;
+  }
+
+  const uint32_t results_ptr = request.results_ptr();
+  auto* results = memory_->TranslateVirtual(results_ptr);
+  std::memset(results, 0, results_size);
+
+  const std::string query = "/xlive/v1/storage/enumerate?path=" + UrlEncode(*http_prefix);
+  const auto response = xlive::Request("GET", query);
+  nlohmann::json items = nlohmann::json::array();
+  if (response.ok()) {
+    auto parsed = nlohmann::json::parse(response.body, nullptr, false);
+    if (!parsed.is_discarded() && parsed.contains("items") && parsed["items"].is_array()) {
+      items = parsed["items"];
+    }
+  }
+  if (REXCVAR_GET(net_log)) {
+    REXKRNL_INFO("xlive: storage ENUMERATE {} -> {} {} items", *http_prefix, response.status,
+                 items.size());
+  }
+  if (!response.ok()) {
+    if (extended_error) {
+      *extended_error = X_E_FAIL;
+    }
+    return X_ERROR_FUNCTION_FAILED;
+  }
+
+  const uint32_t max_items = std::min(capacity, max_results ? max_results : capacity);
+  const uint32_t items_ptr = results_ptr + kEnumerateResultsSize;
+  const uint32_t paths_ptr = items_ptr + capacity * kFileInfoSize;
+  uint32_t returned = 0;
+  for (size_t i = starting_index; i < items.size() && returned < max_items; ++i) {
+    const auto& item = items[i];
+    if (!item.is_object() || !item.contains("path") || !item["path"].is_string()) {
+      continue;
+    }
+    std::string path = item["path"].get<std::string>();
+    if (path.rfind("/storage/", 0) != 0) {
+      path = (path.rfind('/', 0) == 0 ? "/storage" : "/storage/") + path;
+    }
+    const std::string guest_item = HttpPathToGuest(path, facility_path);
+    const uint32_t size =
+        item.contains("size") && item["size"].is_number() ? item["size"].get<uint32_t>() : 0;
+    const uint64_t created =
+        JsonTimeToFiletime(item.contains("created") ? item["created"] : nlohmann::json());
+    const uint64_t modified =
+        item.contains("modified") ? JsonTimeToFiletime(item["modified"]) : created;
+    const uint32_t path_address = paths_ptr + returned * kMaxPathnameLength * 2;
+    WriteGuestString(memory_->TranslateVirtual(path_address), guest_item, kMaxPathnameLength);
+
+    uint8_t* info = memory_->TranslateVirtual(items_ptr + returned * kFileInfoSize);
+    store_and_swap<uint32_t>(info + 0x00, kernel_state_->title_id());  // title_id
+    store_and_swap<uint32_t>(info + 0x04, 0);                          // title_version
+    store_and_swap<uint64_t>(info + 0x08, 0);                          // owner_puid
+    info[0x10] = 0;                                                    // country_id
+    store_and_swap<uint64_t>(info + 0x11, 0);                          // reserved
+    store_and_swap<uint32_t>(info + 0x19, kContentTypeStorageDownload);
+    store_and_swap<uint32_t>(info + 0x1D, size);  // storage_size
+    store_and_swap<uint32_t>(info + 0x21, size);  // installed_size
+    store_and_swap<uint64_t>(info + 0x25, created);
+    store_and_swap<uint64_t>(info + 0x2D, modified);
+    store_and_swap<uint16_t>(info + 0x35, 0);  // attributes_size
+    store_and_swap<uint16_t>(info + 0x37,
+                             uint16_t(std::min<size_t>(guest_item.size(), kMaxPathnameLength - 1)));
+    store_and_swap<uint32_t>(info + 0x39, path_address);
+    store_and_swap<uint32_t>(info + 0x3D, 0);  // attributes_ptr
+    ++returned;
+  }
+  store_and_swap<uint32_t>(results + 0x0, uint32_t(items.size()));  // total_num_items
+  store_and_swap<uint32_t>(results + 0x4, returned);                // num_items_returned
+  store_and_swap<uint32_t>(results + 0x8, items_ptr);
+  return X_E_SUCCESS;
+}
+
+X_HRESULT XLiveBaseApp::XStringVerify(uint32_t buffer_ptr) {
+  // title id, flags, locale length, string count, locale, then per string a
+  // length and UTF-8 bytes. Every string passes (no offensive-string filter);
+  // Halo 3 retries until this succeeds once online.
+  MarshalledRequest request(memory_, buffer_ptr);
+  if (!request.valid() || !request.results_ptr()) {
+    return X_E_INVALIDARG;
+  }
+  request.ReadU32();  // title id
+  request.ReadU32();  // flags
+  const uint16_t locale_size = request.ReadU16();
+  const uint16_t num_strings = request.ReadU16();
+  request.Skip(locale_size);
+  for (uint16_t i = 0; i < num_strings && !request.overrun(); ++i) {
+    request.Skip(request.ReadU16());
+  }
+  // STRING_VERIFY_RESPONSE (packed: u16 count, u32 results pointer) followed
+  // by one HRESULT per string.
+  constexpr uint32_t kResponseSize = 6;
+  const uint32_t results_ptr = request.results_ptr();
+  if (request.overrun() || request.results_size() < kResponseSize + num_strings * 4u) {
+    return X_E_INVALIDARG;
+  }
+  auto* results = memory_->TranslateVirtual(results_ptr);
+  std::memset(results, 0, request.results_size());
+  store_and_swap<uint16_t>(results + 0, num_strings);
+  store_and_swap<uint32_t>(results + 2, results_ptr + kResponseSize);
+  if (REXCVAR_GET(net_log)) {
+    REXKRNL_INFO("xlive: XStringVerify {} strings -> ok", num_strings);
+  }
+  return X_E_SUCCESS;
+}
+
+X_HRESULT XLiveBaseApp::XOnlineGetTaskProgress(uint32_t buffer_ptr) {
+  // Every task above completes before XMsgStartIORequest returns.
+  if (!buffer_ptr) {
+    return X_E_INVALIDARG;
+  }
+  auto* progress = memory_->TranslateVirtual<X_GET_TASK_PROGRESS*>(buffer_ptr);
+  if (progress->percent_complete_ptr) {
+    store_and_swap<uint32_t>(memory_->TranslateVirtual(progress->percent_complete_ptr), 100);
+  }
+  if (progress->numerator_ptr) {
+    store_and_swap<uint64_t>(memory_->TranslateVirtual(progress->numerator_ptr), 100);
+  }
+  if (progress->denominator_ptr) {
+    store_and_swap<uint64_t>(memory_->TranslateVirtual(progress->denominator_ptr), 100);
+  }
+  return X_E_SUCCESS;
+}
+
 }  // namespace apps
 }  // namespace xam
 }  // namespace kernel
