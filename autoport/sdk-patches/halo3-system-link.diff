+uint16_t ToHostPort(uint16_t guest_port) {
+  return (guest_port && guest_port < 1024) ? uint16_t(guest_port + REXCVAR_GET(net_port_offset))
+                                           : guest_port;
+}
+
+uint16_t ToGuestPort(uint16_t host_port) {
+  const uint32_t offset = REXCVAR_GET(net_port_offset);
+  return (host_port >= offset && host_port < offset + 1024) ? uint16_t(host_port - offset)
+                                                            : host_port;
+}
