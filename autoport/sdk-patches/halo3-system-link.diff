+
+uint32_t SecureFromIp(uint32_t ip, bool create) {
+  std::lock_guard<std::mutex> lock(secure_mutex);
+  auto it = ip_to_secure.find(ip);
+  if (it != ip_to_secure.end()) {
+    return it->second;
+  }
+  if (!create) {
+    return 0;
+  }
+  const uint32_t secure = next_secure++ & 0x00FFFFFF;
+  ip_to_secure[ip] = secure;
+  secure_to_ip[secure] = ip;
+  return secure;
+}
+
+bool IpFromSecure(uint32_t secure, uint32_t* ip) {
+  std::lock_guard<std::mutex> lock(secure_mutex);
+  auto it = secure_to_ip.find(secure);
+  if (it == secure_to_ip.end()) {
+    return false;
+  }
+  *ip = it->second;
+  return true;
+}
+
+void ForgetSecure(uint32_t secure) {
+  std::lock_guard<std::mutex> lock(secure_mutex);
+  auto it = secure_to_ip.find(secure);
+  if (it != secure_to_ip.end()) {
+    ip_to_secure.erase(it->second);
+    secure_to_ip.erase(it);
+  }
+  title_server_secure.erase(secure);
+}
+
+void MarkTitleServer(uint32_t secure) {
+  std::lock_guard<std::mutex> lock(secure_mutex);
+  title_server_secure.insert(secure);
+}
+
+bool IsTitleServer(uint32_t secure) {
+  std::lock_guard<std::mutex> lock(secure_mutex);
+  return title_server_secure.count(secure) != 0;
+}
