+++ b/src/kernel/xam/apps/xlivebase_app.cpp
@@ -10,25 +10,435 @@
  */
 
 #include <rex/kernel/xam/apps/xlivebase_app.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <rex/cvar.h>
 #include <rex/logging.h>
+#include <rex/memory/utils.h>
+#include <rex/system/xam/user_profile.h>
+#include <rex/system/xlive.h>
 #include <rex/thread.h>
 
+#include <fmt/format.h>
+#include <inja/third_party/include/nlohmann/json.hpp>
+
+REXCVAR_DECLARE(bool, net_log);
+
 namespace rex {
 namespace kernel {
 namespace xam {
 using namespace rex::system;
 using namespace rex::system::xam;
+bool XamFreeContaining(uint32_t address, uint32_t keep);  // xam_info.cpp
+
 namespace apps {
 using namespace rex::system;
 
 XLiveBaseApp::XLiveBaseApp(KernelState* kernel_state) : App(kernel_state, 0xFC) {}
 
+namespace {
+
+namespace xlive = rex::system::xlive;
+using rex::memory::load_and_swap;
+using rex::memory::store_and_swap;
+
+constexpr X_HRESULT kOnlineLogonNotLoggedOn = 0x80151802;
+constexpr X_HRESULT kStorageFileIsTooBig = 0x8015C003;
+constexpr X_HRESULT kStorageFileNotFound = 0x8015C004;
+constexpr X_HRESULT kStorageInvalidStoragePath = 0x8015C008;
+constexpr X_HRESULT kStorageInvalidFacility = 0x8015C009;
+constexpr X_HRESULT kStorageFileNotModified = 0x0015C013;
+
+constexpr uint32_t kMaxPathnameLength = 255;  // X_ONLINE_MAX_PATHNAME_LENGTH
+constexpr uint32_t kMaxResultsToReturn = 256;  // X_STORAGE_MAX_RESULTS_TO_RETURN
+constexpr uint32_t kUserIndexNone = 0xFF;
+constexpr uint32_t kContentTypeStorageDownload = 0x000D0000;
+
+enum StorageFacility : uint32_t {
+  kFacilityGameClip = 1,     // Read, Write
+  kFacilityPerTitle = 2,     // Read, Enumerate
+  kFacilityPerUserTitle = 3  // Read, Write, Delete
+};
+
+// XStorageBuildServerPath arguments (message 0x58035, not marshalled).
+struct X_STORAGE_BUILD_SERVER_PATH {
+  be<uint32_t> user_index;
+  be<uint32_t> pad;
+  be<uint64_t> xuid;
+  be<uint32_t> storage_location;
+  be<uint32_t> storage_location_info_ptr;
+  be<uint32_t> storage_location_info_size;
+  be<uint32_t> file_name_ptr;
+  be<uint32_t> server_path_ptr;
+  be<uint32_t> server_path_length_ptr;
+};
+static_assert(sizeof(X_STORAGE_BUILD_SERVER_PATH) == 0x28);
+
+struct X_GET_TASK_PROGRESS {
+  be<uint32_t> overlapped_ptr;
+  be<uint32_t> percent_complete_ptr;
+  be<uint32_t> numerator_ptr;
+  be<uint32_t> denominator_ptr;
+};
+static_assert(sizeof(X_GET_TASK_PROGRESS) == 0x10);
+
+// Marshalled XLive tasks (the title's XOnline library, via XMsgStartIORequest):
+// the message buffer is an XLIVEBASE_ASYNC_MESSAGE whose first field points at
+// an XLIVE_ASYNC_TASK; the request arguments are serialized big-endian at
+// marshalled_request_ptr, and results go to results_ptr.
+struct XLIVE_ASYNC_TASK {
+  be<uint32_t> ordinal;
+  be<uint32_t> schema_data_ptr;
+  be<uint32_t> schema_index;
+  be<uint32_t> task_flags;
+  be<uint32_t> live_async_task_internal_ptr;
+  be<uint32_t> internal_task_size;
+  be<uint32_t> marshalled_request_ptr;
+  be<uint32_t> marshalled_request_size;
+  be<uint32_t> total_wire_buffer_size;
+  be<uint32_t> counter;
+  be<uint32_t> logon_id;
+  be<uint32_t> results_ptr;
+  be<uint32_t> results_size;
+  be<uint32_t> wire_buffer[5];
+  be<uint32_t> overlapped_ptr;
+};
+static_assert(sizeof(XLIVE_ASYNC_TASK) == 0x4C);
+
+// Packed result layouts (offsets as in xenia-netplay's xnet.h).
+// X_STORAGE_DOWNLOAD_TO_MEMORY_RESULTS
+constexpr uint32_t kDownloadResultsSize = 0x14;
+// X_STORAGE_ENUMERATE_RESULTS followed by X_STORAGE_FILE_INFO[] and paths
+constexpr uint32_t kEnumerateResultsSize = 0xC;
+constexpr uint32_t kFileInfoSize = 0x41;
+
+// Reads a marshalled request: user index, then the server path, then the
+// message's own fields.
+class MarshalledRequest {
+ public:
+  MarshalledRequest(memory::Memory* memory, uint32_t buffer_ptr) {
+    if (!buffer_ptr) {
+      return;
+    }
+    const uint32_t task_ptr = load_and_swap<uint32_t>(memory->TranslateVirtual(buffer_ptr));
+    if (!task_ptr) {
+      return;
+    }
+    task_ = memory->TranslateVirtual<XLIVE_ASYNC_TASK*>(task_ptr);
+    if (!task_->marshalled_request_ptr) {
+      task_ = nullptr;
+      return;
+    }
+    data_ = memory->TranslateVirtual<uint8_t*>(task_->marshalled_request_ptr);
+    size_ = task_->marshalled_request_size;
+  }
+
+  bool valid() const { return task_ != nullptr; }
+  bool overrun() const { return overrun_; }
+  size_t position() const { return position_; }
+  size_t size() const { return size_; }
+  uint32_t results_ptr() const { return task_ ? uint32_t(task_->results_ptr) : 0; }
+  uint32_t results_size() const { return task_ ? uint32_t(task_->results_size) : 0; }
+
+  uint32_t ReadU32() {
+    if (position_ + 4 > size_) {
+      overrun_ = true;
+      return 0;
+    }
+    const uint32_t v = load_and_swap<uint32_t>(data_ + position_);
+    position_ += 4;
+    return v;
+  }
+
+  uint16_t ReadU16() {
+    if (position_ + 2 > size_) {
+      overrun_ = true;
+      return 0;
+    }
+    const uint16_t v = load_and_swap<uint16_t>(data_ + position_);
+    position_ += 2;
+    return v;
+  }
+
+  void Skip(size_t count) {
+    if (position_ + count > size_) {
+      overrun_ = true;
+      position_ = size_;
+      return;
+    }
+    position_ += count;
+  }
+
+  // A counted UTF-16 string (the count includes the terminator).
+  std::string ReadPath(uint32_t length) {
+    std::string out;
+    if (position_ + size_t(length) * 2 > size_) {
+      overrun_ = true;
+      return out;
+    }
+    for (uint32_t i = 0; i < length; ++i) {
+      const uint16_t c = load_and_swap<uint16_t>(data_ + position_ + i * 2);
+      if (!c) {
+        break;
+      }
+      out += c < 0x80 ? char(c) : '?';
+    }
+    position_ += size_t(length) * 2;
+    return out;
+  }
+
+  // The fields common to every storage message.
+  bool ReadUserAndPath(uint32_t* user_index, std::string* path) {
+    *user_index = ReadU32();
+    const uint32_t length = ReadU32();
+    if (length > kMaxPathnameLength + 1) {
+      return false;
+    }
+    *path = ReadPath(length);
+    return !overrun_;
+  }
+
+ private:
+  XLIVE_ASYNC_TASK* task_ = nullptr;
+  uint8_t* data_ = nullptr;
+  size_t size_ = 0;
+  size_t position_ = 0;
+  bool overrun_ = false;
+};
+
+void WriteGuestString(uint8_t* dest, const std::string& text, uint32_t capacity_chars) {
+  if (!capacity_chars) {
+    return;
+  }
+  const uint32_t n = std::min<uint32_t>(uint32_t(text.size()), capacity_chars - 1);
+  for (uint32_t i = 0; i < n; ++i) {
+    store_and_swap<uint16_t>(dest + i * 2, uint16_t(uint8_t(text[i])));
+  }
+  store_and_swap<uint16_t>(dest + n * 2, 0);
+}
+
+std::string ReadGuestString(const uint8_t* src, uint32_t max_chars) {
+  std::string out;
+  for (uint32_t i = 0; i < max_chars; ++i) {
+    const uint16_t c = load_and_swap<uint16_t>(src + i * 2);
+    if (!c) {
+      break;
+    }
+    out += c < 0x80 ? char(c) : '?';
+  }
+  return out;
+}
+
+std::optional<uint64_t> ParseHexField(const std::string& s, size_t digits) {
+  if (s.size() != digits) {
+    return std::nullopt;
+  }
+  return xlive::ParseHex64(s);
+}
+
+// Guest server paths (the format XStorageBuildServerPath hands out, as in
+// xenia-netplay) and their HTTP paths on live_server:
+//   //title.<title>/t:<title>/<file>          -> /storage/title/<TITLE>/<file>
+//   //tuser.<title>/u:<xuid>/<title>/<file>   -> /storage/user/<XUID>/<TITLE>/<file>
+//   //xestats/u:<xuid>/<title>/<view>          -> /storage/clip/<TITLE>/<XUID>/<VIEW>
+// A path the title built itself ("/storage/...") is used as is.
+std::optional<std::string> GuestPathToHttp(const std::string& guest) {
+  if (guest.size() > 1 && guest[0] == '/' && guest[1] != '/') {
+    return guest;
+  }
+  auto split = [](const std::string& s, size_t count) {
+    std::vector<std::string> parts;
+    size_t pos = 0;
+    while (parts.size() + 1 < count) {
+      const size_t slash = s.find('/', pos);
+      if (slash == std::string::npos) {
+        break;
+      }
+      parts.push_back(s.substr(pos, slash - pos));
+      pos = slash + 1;
+    }
+    parts.push_back(s.substr(pos));
+    return parts;
+  };
+  if (guest.rfind("//title.", 0) == 0) {
+    // title.<t> / t:<t> / file
+    auto parts = split(guest.substr(2), 3);
+    if (parts.size() != 3 || parts[1].rfind("t:", 0) != 0 || parts[2].empty()) {
+      return std::nullopt;
+    }
+    auto title = ParseHexField(parts[0].substr(6), 8);
+    if (!title) {
+      return std::nullopt;
+    }
+    return fmt::format("/storage/title/{:08X}/{}", *title, parts[2]);
+  }
+  if (guest.rfind("//tuser.", 0) == 0) {
+    auto parts = split(guest.substr(2), 4);
+    if (parts.size() != 4 || parts[1].rfind("u:", 0) != 0 || parts[3].empty()) {
+      return std::nullopt;
+    }
+    auto title = ParseHexField(parts[0].substr(6), 8);
+    auto xuid = ParseHexField(parts[1].substr(2), 16);
+    if (!title || !xuid) {
+      return std::nullopt;
+    }
+    return fmt::format("/storage/user/{:016X}/{:08X}/{}", *xuid, *title, parts[3]);
+  }
+  if (guest.rfind("//xestats/", 0) == 0) {
+    auto parts = split(guest.substr(10), 3);
+    if (parts.size() != 3 || parts[0].rfind("u:", 0) != 0) {
+      return std::nullopt;
+    }
+    auto xuid = ParseHexField(parts[0].substr(2), 16);
+    auto title = ParseHexField(parts[1], 8);
+    auto view = ParseHexField(parts[2], 8);
+    if (!xuid || !title || !view) {
+      return std::nullopt;
+    }
+    return fmt::format("/storage/clip/{:08X}/{:016X}/{:08X}", *title, *xuid, *view);
+  }
+  return std::nullopt;
+}
+
+// Inverse of GuestPathToHttp, for enumeration results.
+std::string HttpPathToGuest(const std::string& http, bool facility_path) {
+  if (!facility_path) {
+    return http;
+  }
+  auto rest_after = [&](const std::string& prefix) -> std::optional<std::string> {
+    if (http.size() <= prefix.size() || http.compare(0, prefix.size(), prefix) != 0) {
+      return std::nullopt;
+    }
+    return http.substr(prefix.size());
+  };
+  if (auto rest = rest_after("/storage/title/"); rest && rest->size() > 9) {
+    const std::string title = rest->substr(0, 8);
+    std::string lower = title;
+    for (auto& c : lower) c = char(std::tolower(uint8_t(c)));
+    return fmt::format("//title.{}/t:{}/{}", lower, lower, rest->substr(9));
+  }
+  if (auto rest = rest_after("/storage/user/"); rest && rest->size() > 26) {
+    std::string xuid = rest->substr(0, 16);
+    std::string title = rest->substr(17, 8);
+    for (auto& c : xuid) c = char(std::tolower(uint8_t(c)));
+    for (auto& c : title) c = char(std::tolower(uint8_t(c)));
+    return fmt::format("//tuser.{}/u:{}/{}/{}", title, xuid, title, rest->substr(26));
+  }
+  return http;
+}
+
+std::string UrlEncode(const std::string& s) {
+  std::string out;
+  for (unsigned char c : s) {
+    if (std::isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~' || c == '/') {
+      out += char(c);
+    } else {
+      out += fmt::format("%{:02X}", c);
+    }
+  }
+  return out;
+}
+
+uint64_t UnixToFiletime(int64_t seconds) {
+  return uint64_t(seconds + 11644473600ll) * 10000000ull;
+}
+
+// "created"/"modified": unix seconds or an ISO 8601 UTC timestamp.
+uint64_t JsonTimeToFiletime(const nlohmann::json& value) {
+  if (value.is_number()) {
+    return UnixToFiletime(value.get<int64_t>());
+  }
+  if (value.is_string()) {
+    std::tm tm{};
+    const std::string text = value.get<std::string>();
+    if (std::sscanf(text.c_str(), "%d-%d-%dT%d:%d:%d", &tm.tm_year, &tm.tm_mon, &tm.tm_mday,
+                    &tm.tm_hour, &tm.tm_min, &tm.tm_sec) >= 3) {
+      tm.tm_year -= 1900;
+      tm.tm_mon -= 1;
+      return UnixToFiletime(int64_t(timegm(&tm)));
+    }
+  }
+  return UnixToFiletime(int64_t(std::time(nullptr)));
+}
+
+void LogStorage(const char* method, const std::string& path, int status, size_t bytes) {
+  if (REXCVAR_GET(net_log)) {
+    REXKRNL_INFO("xlive: storage {} {} -> {} {}", method, path, status, bytes);
+  }
+}
+
