+// ---------------------------------------------------------------------------
+// QoS. Before joining, titles probe the host with XNetQosLookup; the host's
+// reply carries the data it published with XNetQosListen (Halo 3 refuses to
+// join without it: "incompatible network setup"). Instances run the same
+// exchange over UDP: each answers probes on its own address at port
+// net_port_offset + 1023, and lookups probe every target and fill XNQOS
+// asynchronously.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+constexpr uint32_t kQosMagic = 0x58514F53;  // 'XQOS'
+constexpr uint8_t kQosProbe = 1;
+constexpr uint8_t kQosReply = 2;
+constexpr uint32_t kQosMaxData = 1024;
+constexpr uint32_t kQosTimeoutMs = 600;
+
+// XNQOSINFO flags.
+constexpr uint8_t kQosInfoComplete = 0x01;
+constexpr uint8_t kQosInfoTargetContacted = 0x02;
+constexpr uint8_t kQosInfoTargetDisabled = 0x04;
+constexpr uint8_t kQosInfoDataReceived = 0x08;
+
+// XNetQosListen flags.
+constexpr uint32_t kQosListenEnable = 0x01;
+constexpr uint32_t kQosListenDisable = 0x02;
+constexpr uint32_t kQosListenSetData = 0x04;
+constexpr uint32_t kQosListenRelease = 0x10;
+
+#pragma pack(push, 1)
+struct QosPacket {
+  uint32_t magic;
+  uint8_t type;
+  uint8_t enabled;
+  uint16_t data_len;
+  uint8_t xnkid[8];
+  uint32_t nonce;
+  // data follows (replies)
+};
+#pragma pack(pop)
+
+struct QosListener {
+  bool enabled = false;
+  std::vector<uint8_t> data;
+};
+
+std::mutex qos_mutex;
+std::map<uint64_t, QosListener> qos_listeners;  // by XNKID
+// Lookups in flight, by guest XNQOS address; XNetQosRelease cancels.
+std::map<uint32_t, bool> qos_lookups;
+
+uint16_t QosPort() {
+  return uint16_t(REXCVAR_GET(net_port_offset) + 1023);
+}
+
+uint64_t LoadXnkid(const uint8_t* p) {
+  uint64_t v = 0;
+  std::memcpy(&v, p, 8);
+  return v;
+}
+
+void QosResponder() {
+  int fd = socket(AF_INET, SOCK_DGRAM, 0);
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(QosPort());
+  addr.sin_addr.s_addr = xnet::LoopbackMode() ? htonl(xnet::LocalAddress()) : INADDR_ANY;
+  if (fd < 0 || bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
+    REXKRNL_ERROR("XNetQosListen: cannot bind the QoS responder to port {}: {}", QosPort(),
+                  strerror(errno));
+    if (fd >= 0) {
+      close(fd);
+    }
+    return;
+  }
+  std::vector<uint8_t> buf(sizeof(QosPacket) + kQosMaxData);
+  for (;;) {
+    sockaddr_in from{};
+    socklen_t from_len = sizeof(from);
+    ssize_t n = recvfrom(fd, buf.data(), buf.size(), 0, reinterpret_cast<sockaddr*>(&from),
+                         &from_len);
+    if (n < ssize_t(sizeof(QosPacket))) {
+      continue;
+    }
+    QosPacket probe;
+    std::memcpy(&probe, buf.data(), sizeof(probe));
+    if (probe.magic != kQosMagic || probe.type != kQosProbe) {
+      continue;
+    }
+    std::vector<uint8_t> reply(sizeof(QosPacket));
+    QosPacket header = probe;
+    header.type = kQosReply;
+    header.enabled = 0;
+    header.data_len = 0;
+    {
+      std::lock_guard<std::mutex> lock(qos_mutex);
+      auto it = qos_listeners.find(LoadXnkid(probe.xnkid));
+      if (it != qos_listeners.end() && it->second.enabled) {
+        header.enabled = 1;
+        header.data_len = uint16_t(it->second.data.size());
+        reply.insert(reply.end(), it->second.data.begin(), it->second.data.end());
+      } else if (it != qos_listeners.end()) {
+        // A session member that switched its listener off (Halo 3 joiners do
+        // for the session they joined) still answers as reachable, without
+        // data: members probe each other to check the peer mesh, and a
+        // "disabled" answer made the host evict them.
+        header.enabled = 1;
+        header.data_len = 0;
+      }
+    }
+    std::memcpy(reply.data(), &header, sizeof(header));
+    sendto(fd, reply.data(), reply.size(), 0, reinterpret_cast<sockaddr*>(&from), from_len);
+    if (REXCVAR_GET(net_log)) {
+      std::string keys;
+      {
+        std::lock_guard<std::mutex> lock(qos_mutex);
+        for (const auto& [k, l] : qos_listeners) {
+          keys += fmt::format(" {:016X}{}", rex::byte_swap(k), l.enabled ? "" : "(off)");
+        }
+      }
+      REXKRNL_INFO("net: QoS probe from {} for {:016X} -> {} (listening:{})",
+                   inet_ntoa(from.sin_addr), rex::byte_swap(LoadXnkid(probe.xnkid)),
+                   header.enabled ? "listening" : "not listening", keys);
+    }
+  }
+}
+
+void StartQosResponder() {
+  static std::once_flag once;
+  std::call_once(once, [] { std::thread(QosResponder).detach(); });
+}
