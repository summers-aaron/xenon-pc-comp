+// ---- server calls ---------------------------------------------------------
+
+std::optional<json> Call(const std::string& method, const std::string& path, const json& body) {
+  const auto r = xlive::Request(method, path, body.is_null() ? std::string() : body.dump());
+  if (REXCVAR_GET(net_log)) {
+    REXKRNL_INFO("xlive: {} {} -> {}", method, path, r.status);
+  }
+  if (!r.ok()) {
+    if (r.status != 404) {
+      REXKRNL_WARN("xlive: {} {} failed (HTTP {}): {}", method, path, r.status,
+                   r.body.substr(0, 200));
+    }
+    return std::nullopt;
+  }
+  if (r.body.empty()) {
+    return json::object();
+  }
+  auto parsed = json::parse(r.body, nullptr, false);
+  if (parsed.is_discarded()) {
+    return std::nullopt;
+  }
+  return parsed;
+}
