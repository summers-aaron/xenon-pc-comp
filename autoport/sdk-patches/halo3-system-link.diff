+                 : index < 0x4000 ? 4 : index < 0x4800 ? 5 : index < 0x4A00 ? 6 : 7;
+  ++stats.reg_writes_by_range[range];
+}
+void Report() {
+  const double f = double(stats.frames);
+  std::fprintf(file, "=== %llu frames (per-frame averages)\n", (unsigned long long)stats.frames);
+  for (uint32_t op = 0; op < 128; ++op) {
+    if (!stats.type3_ring[op] && !stats.type3_indirect[op]) continue;
+    const char* name = OpName(op);
+    std::fprintf(file, "  type3 %-22s 0x%02X  ring %9.1f  indirect %9.1f\n", name ? name : "?", op,
+                 stats.type3_ring[op] / f, stats.type3_indirect[op] / f);
+  }
+  std::fprintf(file, "  type0 packets %.1f, register writes %.1f; type1 packets %.1f\n",
+               stats.type0_packets / f, stats.type0_writes / f, stats.type1_packets / f);
+  static const char* kRanges[] = {"0000-1FFF", "2000 ctx", "2100 ctx", "2200 ctx", "2300-3FFF",
+                                  "4000 ALU consts", "4800 fetch/bool/loop", "other"};
+  for (int i = 0; i < 8; ++i) {
+    if (stats.reg_writes_by_range[i]) {
+      std::fprintf(file, "    reg %-20s %9.1f\n", kRanges[i], stats.reg_writes_by_range[i] / f);
+    }
+  }
+  uint64_t reused = 0;
+  for (auto& [address, uses] : stats.indirect_addresses) {
+    if (uses > 1) ++reused;
+  }
+  std::fprintf(file,
+               "  indirect buffers %.1f/frame, %.1f dwords/frame; %zu distinct addresses, %llu used "
+               "more than once\n",
+               stats.indirect_buffers / f, stats.indirect_dwords / f, stats.indirect_addresses.size(),
+               (unsigned long long)reused);
+  std::fflush(file);
+  stats = Stats();
+}
+void Swap() {
+  if (!file) return;
+  if (++stats.frames == 300) Report();
